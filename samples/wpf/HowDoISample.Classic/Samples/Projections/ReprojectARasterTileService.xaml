<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.ReprojectARasterTileService"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton Content="Spherical Mercator (EPSG:3857), as served" Tag="3857" GroupName="Projection" IsChecked="True" Margin="0,2" Checked="Projection_Checked"/>
                <RadioButton Content="Decimal degrees (EPSG:4326)" Tag="4326" GroupName="Projection" Margin="0,2" Checked="Projection_Checked"/>
                <RadioButton Content="UTM zone 32N (EPSG:25832)" Tag="25832" GroupName="Projection" Margin="0,2" Checked="Projection_Checked"/>
                <RadioButton Content="Polar Stereographic" Tag="polar" GroupName="Projection" Margin="0,2" Checked="Projection_Checked"/>
                <RadioButton Content="Albers Equal Area Conic" Tag="albers" GroupName="Projection" Margin="0,2" Checked="Projection_Checked"/>

                <TextBlock x:Name="Status" Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="OpenStreetMap serves its tiles in Spherical Mercator. A GdalProjectionConverter on the layer reprojects them, and the reprojected tiles are kept in the layer's ProjectedTileCache."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
