<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.ProjectFeatures"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton Content="Convert features with a ProjectionConverter" Tag="convert" GroupName="Mode" IsChecked="True" Margin="0,2"
                             Checked="Mode_Checked"/>
                <RadioButton Content="Set the projection of a layer" Tag="layer" GroupName="Mode" Margin="0,2"
                             Checked="Mode_Checked"/>
                <RadioButton Content="Convert features with the ThinkGeo Cloud" Tag="cloud" GroupName="Mode" Margin="0,2"
                             Checked="Mode_Checked"/>

                <TextBlock x:Name="LayerInfo" Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Frisco's subdivisions are stored in Texas North Central state plane (EPSG:2276). The layer's FeatureSource carries a ProjectionConverter, so every feature it reads comes back in Spherical Mercator (EPSG:3857), the map's projection."/>

                <StackPanel x:Name="WktPanel" Margin="0,10,0,0">
                    <TextBlock Text="Features in decimal degrees (EPSG:4326), one WKT per line" FontSize="11" TextWrapping="Wrap"/>
                    <TextBox x:Name="TxtWkt" Height="180" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="POINT(-96.834516 33.150083)&#x0a;LINESTRING(-96.83559 33.149,-96.835866046134 33.1508413556856,-96.835793626491 33.1508974965687,-96.8336008970734 33.1511063402186,-96.83356 33.15109,-96.83328 33.14922)&#x0a;POLYGON((-96.83582 33.1508,-96.83578 33.15046,-96.83353 33.15068,-96.83358 33.15102,-96.83582 33.1508))"/>
                    <Button Content="Project and display" Height="24" Margin="0,6,0,0" Click="Project_Click"/>
                </StackPanel>

                <TextBlock x:Name="Status" Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
