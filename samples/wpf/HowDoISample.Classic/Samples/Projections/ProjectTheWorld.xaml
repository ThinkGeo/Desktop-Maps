<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.ProjectTheWorld"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton Content="Decimal degrees (EPSG:4326)" Tag="4326" GroupName="Projection" IsChecked="True" Margin="0,2" Checked="Projection_Checked"/>
                <RadioButton Content="MGA Zone 55" Tag="mga55" GroupName="Projection" Margin="0,2" Checked="Projection_Checked"/>
                <RadioButton Content="Equal Area - Albers Conic" Tag="albers" GroupName="Projection" Margin="0,2" Checked="Projection_Checked"/>
                <RadioButton Content="Polar Stereographic" Tag="polar" GroupName="Projection" Margin="0,2" Checked="Projection_Checked"/>
                <RadioButton Content="Equal Area - Cylindrical" Tag="cylindrical" GroupName="Projection" Margin="0,2" Checked="Projection_Checked"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="The vector tiles are in Spherical Mercator (EPSG:3857). A ProjectionConverter on the layer draws them in the projection you pick."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
