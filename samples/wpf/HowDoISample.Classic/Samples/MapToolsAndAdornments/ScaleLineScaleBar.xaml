<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.ScaleLineScaleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="Scale line unit system" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton Content="ImperialAndMetric" Tag="ImperialAndMetric" IsChecked="True" Margin="0,2" Checked="UnitSystem_Checked"/>
                <RadioButton Content="MetricAndNauticalMile" Tag="MetricAndNauticalMile" Margin="0,2" Checked="UnitSystem_Checked"/>
                <RadioButton Content="NauticalMileAndImperial" Tag="NauticalMileAndImperial" Margin="0,2" Checked="UnitSystem_Checked"/>
                <RadioButton Content="Default" Tag="Default" Margin="0,2" Checked="UnitSystem_Checked"/>

                <CheckBox x:Name="ChkCustomTextStyles" Content="Custom text styles for the scale line" Margin="0,12,0,0"
                          Checked="ChkCustomTextStyles_OnChecked" Unchecked="ChkCustomTextStyles_OnUnchecked"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
