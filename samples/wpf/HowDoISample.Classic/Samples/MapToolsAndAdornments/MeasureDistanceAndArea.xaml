<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.MeasureDistanceAndArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <RadioButton x:Name="DistanceMode" Content="Distance" IsChecked="True" Margin="10,8,6,8" VerticalAlignment="Center" Checked="Tool_Checked"
                         ToolTip="Press, drag and release to measure a distance and its bearing."/>
            <RadioButton x:Name="AreaMode" Content="Area" Margin="6,8,6,8" VerticalAlignment="Center" Checked="Tool_Checked"
                         ToolTip="Click the corners of a polygon and double-click the last one to measure its area."/>
            <Button Content="Clear" Padding="10,2,10,2" Margin="10,6,10,6" Click="Clear_Click"/>
        </StackPanel>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
