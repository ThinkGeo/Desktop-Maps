<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.MeasureDistanceAndArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="270" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="Measure" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton x:Name="DistanceMode" Content="Distance" IsChecked="True" Margin="0,2" Checked="Tool_Checked"
                             ToolTip="Press, drag and release to measure a distance and its bearing."/>
                <RadioButton x:Name="AreaMode" Content="Area" Margin="0,2" Checked="Tool_Checked"
                             ToolTip="Click the corners of a polygon and double-click the last one to measure its area."/>
                <Button Content="Clear" HorizontalAlignment="Left" Padding="12,2" Margin="0,10,0,0" Click="Clear_Click"/>
                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Distance: press, drag and release. Area: click each corner and double-click the last."/>
            </StackPanel>
        </Border>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
