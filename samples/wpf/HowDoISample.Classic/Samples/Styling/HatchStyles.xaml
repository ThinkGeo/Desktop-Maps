<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.HatchStyles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged" />

        <StackPanel Grid.Column="1" Background="DimGray">
            <Label Content="Hatch pattern" Foreground="WhiteSmoke" FontSize="14" FontWeight="Bold" Margin="4,8,4,0" />
            <ComboBox x:Name="HatchPatterns" Margin="8,4,8,0" SelectionChanged="HatchPatterns_SelectionChanged" />
        </StackPanel>
    </Grid>
</UserControl>
