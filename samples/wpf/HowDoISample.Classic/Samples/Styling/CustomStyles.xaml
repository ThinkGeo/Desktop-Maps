<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.CustomStyles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged" />

        <StackPanel Grid.Column="1" Background="DimGray">
            <Label Content="Capital cities" />
            <RadioButton x:Name="DaylightStyle" Content="Day or night there now" Checked="DaylightStyle_Checked" />
            <RadioButton x:Name="PopulationStyle" Content="Sized by population" Checked="PopulationStyle_Checked" />
        </StackPanel>
    </Grid>

    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="WhiteSmoke" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,8,4,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="WhiteSmoke" />
            <Setter Property="Margin" Value="12,4,4,0" />
        </Style>
    </UserControl.Resources>
</UserControl>
