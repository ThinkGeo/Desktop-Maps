<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.RenderPointsLinesAndAreas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged" />

        <StackPanel Grid.Column="1" Background="DimGray">
            <Label Content="Points (PointStyle)" />
            <RadioButton x:Name="SymbolPoints" Content="Symbol" Checked="SymbolPoints_Checked" />
            <RadioButton x:Name="ImagePoints" Content="Image" Checked="ImagePoints_Checked" />
            <RadioButton x:Name="FontPoints" Content="Font character" Checked="FontPoints_Checked" />

            <Label Content="Lines (LineStyle)" />
            <RadioButton x:Name="SolidLines" Content="Solid line" Checked="SolidLines_Checked" />
            <RadioButton x:Name="DashedLines" Content="Dashed line" Checked="DashedLines_Checked" />

            <Label Content="Areas (AreaStyle)" />
            <RadioButton x:Name="FilledAreas" Content="Fill and outline" Checked="FilledAreas_Checked" />
        </StackPanel>
    </Grid>

    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="WhiteSmoke" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,8,4,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="WhiteSmoke" />
            <Setter Property="Margin" Value="12,4,4,0" />
            <Setter Property="GroupName" Value="Mode" />
        </Style>
    </UserControl.Resources>
</UserControl>
