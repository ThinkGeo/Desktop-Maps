<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Databases"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="A file on this computer" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <RadioButton x:Name="Sqlite" Content="SQLite - Frisco restaurants" GroupName="Database" IsChecked="True" Margin="0,2" Checked="Database_Checked"/>
                <RadioButton x:Name="GeoPackage" Content="GeoPackage - surficial geology" GroupName="Database" Margin="0,2" Checked="Database_Checked"/>
                <RadioButton x:Name="FileGeoDatabase" Content="Esri File Geodatabase - Frisco zoning" GroupName="Database" Margin="0,2" Checked="Database_Checked"/>

                <TextBlock Text="A server (ThinkGeo demo database)" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <RadioButton x:Name="Postgres" Content="PostgreSQL / PostGIS - countries" GroupName="Database" Margin="0,2" Checked="Database_Checked"/>
                <RadioButton x:Name="SqlServer" Content="SQL Server - Frisco coyote sightings" GroupName="Database" Margin="0,2" Checked="Database_Checked"/>

                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="A database layer opens one table: a connection, the table name and, where the database needs them, the id and geometry columns. Styling and drawing are the same as for any feature layer."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
