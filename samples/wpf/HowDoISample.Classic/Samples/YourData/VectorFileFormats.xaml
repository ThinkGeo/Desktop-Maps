<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.VectorFileFormats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton x:Name="Shapefile" Content="Shapefile" GroupName="Format" IsChecked="True" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="GeoJson" Content="GeoJSON" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="Kml" Content="KML" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="Gpx" Content="GPX" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="Tab" Content="MapInfo TAB" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="TinyGeo" Content="TinyGeo" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="CadEmbedded" Content="CAD (DWG), with the drawing's own styles" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="CadStandard" Content="CAD (DWG), with styles set in code" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="GeoPdf" Content="GeoPDF" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>
                <RadioButton x:Name="InMemory" Content="In memory (features added in code)" GroupName="Format" Margin="0,2" Checked="Format_Checked"/>

                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Each format has its own feature layer class. Everything after it is the same: a projection converter from the file's coordinate system, the styles of a zoom level, and a LayerOverlay to draw it."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
