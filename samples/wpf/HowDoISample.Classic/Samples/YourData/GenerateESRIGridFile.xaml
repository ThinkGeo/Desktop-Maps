<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.GenerateESRIGridFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Soil pH measured at points across a field. Generating the grid fills every cell between the points by inverse distance weighting, writes an ESRI ASCII grid (.asc) file and shows it in place of the points."/>
                <Button x:Name="GenerateButton" Content="Generate Grid File" Click="GenerateButton_Click" Padding="0,3"/>
                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
