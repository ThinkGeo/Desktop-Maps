<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.OfflineTiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="Image tiles" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <RadioButton x:Name="RasterMbTiles" Content="MBTiles" GroupName="Archive" IsChecked="True" Margin="0,2" Checked="Archive_Checked"/>
                <RadioButton x:Name="RasterPmTiles" Content="PMTiles" GroupName="Archive" Margin="0,2" Checked="Archive_Checked"/>
                <RadioButton x:Name="FileTiles" Content="A folder of z/x/y tiles (made by QGIS)" GroupName="Archive" Margin="0,2" Checked="Archive_Checked"/>

                <TextBlock Text="Vector tiles, drawn by a style.json" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <RadioButton x:Name="VectorMbTiles" Content="MBTiles" GroupName="Archive" Margin="0,2" Checked="Archive_Checked"/>
                <RadioButton x:Name="VectorPmTiles" Content="PMTiles" GroupName="Archive" Margin="0,2" Checked="Archive_Checked"/>

                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Tiles that ship with your application, read from a file instead of a server. A folder of tiles has no layer of its own: a small RasterXyzTileAsyncLayer subclass reads it."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
