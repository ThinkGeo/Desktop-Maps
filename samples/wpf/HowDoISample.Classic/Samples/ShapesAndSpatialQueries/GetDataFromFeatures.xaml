<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.GetDataFromFeatures"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Content="Click a park to read its columns" Tag="one" GroupName="Mode" IsChecked="True" Margin="0,2"
                                 Checked="Mode_Checked"/>
                    <RadioButton Content="List every hotel in the shapefile" Tag="all" GroupName="Mode" Margin="0,2"
                                 Checked="Mode_Checked"/>

                    <TextBlock x:Name="Status" Margin="0,10,0,6" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox x:Name="LsbHotels" Visibility="Collapsed" SelectionChanged="LsbHotels_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,4">
                                <TextBlock Text="{Binding ColumnValues[NAME]}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ColumnValues[ADDRESS], StringFormat=Address: {0}}" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ColumnValues[ROOMS], StringFormat=Rooms: {0}}" FontSize="11" Foreground="#555B62"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>
    </DockPanel>
</UserControl>
