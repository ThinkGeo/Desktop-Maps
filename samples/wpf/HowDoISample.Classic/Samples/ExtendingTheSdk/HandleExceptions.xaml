<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.HandleExceptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="12,8"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <TextBlock FontSize="11.5" Foreground="#555B62" TextWrapping="Wrap"
                       Text="The WMS layer points at an address where no server answers, so every request it makes fails. Choose what the overlay does with the exception."/>
        </Border>

        <Border DockPanel.Dock="Right" Width="270" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="When the layer fails" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton x:Name="DrawDefault" GroupName="Mode" IsChecked="True" Margin="0,2"
                             Content="Draw the exception on the map" Checked="Mode_Checked"/>
                <RadioButton x:Name="DrawCustom" GroupName="Mode" Margin="0,2"
                             Content="Draw it my own way (DrawExceptionCore)" Checked="Mode_Checked"/>
                <RadioButton x:Name="Throw" GroupName="Mode" Margin="0,2"
                             Content="Throw it, and catch it in ThrowingException" Checked="Mode_Checked"/>
                <TextBlock Text="The exception caught" Margin="0,14,0,4" FontSize="11" Foreground="#555B62"/>
                <TextBox x:Name="TxtException" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" FontSize="11"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
