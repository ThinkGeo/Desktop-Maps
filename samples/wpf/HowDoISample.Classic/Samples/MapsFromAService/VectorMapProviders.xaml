<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.VectorMapProviders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton x:Name="ThinkGeoLight" Content="ThinkGeo Cloud - Light" GroupName="Provider" IsChecked="True" Margin="0,2"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="ThinkGeoDark" Content="ThinkGeo Cloud - Dark" GroupName="Provider" Margin="0,2"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="CustomServer" Content="Any MVT server (style.json URL)" GroupName="Provider" Margin="0,2"
                             Checked="Provider_Checked"/>

                <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Style document URL" FontSize="11.5"/>
                    <TextBox x:Name="StyleUrl" Text="https://demotiles.maplibre.org/style.json" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <Button Content="Load" Click="Load_Click" Padding="0,3"/>
                </StackPanel>

                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="ThinkGeo Cloud is one overlay with your API key; its style decides light or dark. Any other vector tile server is a style.json URL in an MvtTilesAsyncLayer."/>
                <TextBlock Margin="0,6,0,0" FontSize="11">
                    <Hyperlink NavigateUri="https://cloud.thinkgeo.com/" RequestNavigate="Hyperlink_RequestNavigate">Sign up for a ThinkGeo Cloud account</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
