<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.NOAAWeather"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton x:Name="Stations" Content="Weather stations" GroupName="Feed" IsChecked="True" Margin="0,2"
                             Checked="Feed_Checked"/>
                <RadioButton x:Name="Warnings" Content="Weather warnings (click one for its title)" GroupName="Feed" Margin="0,2"
                             Checked="Feed_Checked"/>

                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Each feed is a feature layer that downloads the current NOAA data when it opens, and draws it with a style made for that feed."/>
            </StackPanel>
        </Border>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>
            <Image x:Name="LoadingImage" Height="64" Width="64" Visibility="Hidden" Source="/Resources/loading.png"/>
        </Grid>
    </DockPanel>
</UserControl>
