<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.WMTS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton x:Name="Overlay" Content="WmtsOverlay" GroupName="Mode" IsChecked="True" Margin="0,2"
                             Checked="Mode_Checked"/>
                <RadioButton x:Name="AsyncLayer" Content="WmtsAsyncLayer in a LayerOverlay" GroupName="Mode" Margin="0,2"
                             Checked="Mode_Checked"/>

                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="The swisstopo national map in its Swiss grid (EPSG 21781). The map takes its zoom scales from the service's tile matrix set, so every zoom level shows tiles at their own size. Use the overlay on its own, or the layer when it shares a LayerOverlay with other layers."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
