<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.RasterMapProviders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton x:Name="ThinkGeoLight" Content="ThinkGeo Cloud - Light" GroupName="Provider" IsChecked="True" Margin="0,2"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="ThinkGeoDark" Content="ThinkGeo Cloud - Dark" GroupName="Provider" Margin="0,2"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="ThinkGeoAerial" Content="ThinkGeo Cloud - Aerial" GroupName="Provider" Margin="0,2"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="ThinkGeoHybrid" Content="ThinkGeo Cloud - Hybrid" GroupName="Provider" Margin="0,2"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="Osm" Content="OpenStreetMap" GroupName="Provider" Margin="0,2"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="CustomXyz" Content="Any XYZ tile server" GroupName="Provider" Margin="0,2"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="KeyedProviders" Content="Azure Maps and Google Maps" GroupName="Provider" Margin="0,2"
                             Checked="Provider_Checked"/>

                <StackPanel x:Name="CustomXyzPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Tile URL: {0} is the zoom, {1} the column, {2} the row" FontSize="11.5" TextWrapping="Wrap"/>
                    <TextBox x:Name="XyzUrl" Text="https://tile.openstreetmap.org/{0}/{1}/{2}.png" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <Button Content="Load" Click="Load_Click" Padding="0,3"/>
                </StackPanel>

                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="ThinkGeo Cloud and OpenStreetMap each have an overlay of their own. Any other server that serves z/x/y image tiles goes into an OpenStreetMapAsyncLayer through CustomServerUris."/>
            </StackPanel>
        </Border>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>

            <Border x:Name="KeyedProvidersPage" Visibility="Collapsed" Background="White" Padding="20,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Azure Maps and Google Maps" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="These providers need your own API key, so this sample shows how to use them instead of a map. With a key, one overlay puts the provider on the map."/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Overlay" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Layer for a LayerOverlay" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Azure Maps"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="AzureMapsRasterOverlay" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="AzureMapsRasterAsyncLayer" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Google Maps Static"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="GoogleMapsStaticOverlay" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="GoogleMapsStaticAsyncLayer" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Google Map Tiles"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="GoogleMapTilesOverlay" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="GoogleMapTilesAsyncLayer" FontFamily="Consolas"/>
                        </Grid>

                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#F6F6F4" BorderThickness="0" Padding="8"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,12" xml:space="preserve">Map.MapUnit = GeographyUnit.Meter;

// Azure Maps
Map.Overlays.Add(new AzureMapsRasterOverlay("your-azure-maps-key", AzureMapsRasterTileSet.Imagery));

// Google Maps
Map.Overlays.Add(new GoogleMapsStaticOverlay("your-google-api-key", string.Empty));

_ = Map.RefreshAsync();</TextBox>

                        <TextBlock Margin="0,0,0,4">
                            <Hyperlink NavigateUri="https://portal.azure.com/#browse/Microsoft.Maps%2Faccounts" RequestNavigate="Hyperlink_RequestNavigate">Get an Azure Maps key</Hyperlink>
                        </TextBlock>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://developers.google.com/maps/documentation/maps-static/get-api-key" RequestNavigate="Hyperlink_RequestNavigate">Get a Google Maps key</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
