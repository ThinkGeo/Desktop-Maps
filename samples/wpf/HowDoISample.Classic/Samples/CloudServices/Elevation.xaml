<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Elevation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             xmlns:core="clr-namespace:ThinkGeo.Core;assembly=ThinkGeo.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="Draw a point" Click="DrawPoint_Click" Margin="0,2" Padding="0,3"/>
                    <Button Content="Draw a line (up to 5 km)" Click="DrawLine_Click" Margin="0,2" Padding="0,3"/>
                    <Button Content="Draw an area (up to 5 km²)" Click="DrawPolygon_Click" Margin="0,2" Padding="0,3"/>
                    <TextBlock x:Name="TxtAverageElevation" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtHighestElevation"/>
                    <TextBlock x:Name="TxtLowestElevation" Margin="0,0,0,6"/>
                </StackPanel>

                <ListBox x:Name="LsbElevations" SelectionChanged="LsbElevations_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:CloudElevationPointResult}">
                            <StackPanel Margin="0,2,0,4">
                                <TextBlock Text="{Binding Point}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Elevation, StringFormat=Elevation: {0:0.0} feet}" FontSize="11" Foreground="#555B62"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
            <Image x:Name="LoadingImage" Height="64" Width="64" Visibility="Hidden" Source="..\..\Resources\loading.png"/>
        </Grid>
    </DockPanel>
</UserControl>
