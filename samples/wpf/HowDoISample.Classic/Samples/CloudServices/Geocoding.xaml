<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Geocoding"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             xmlns:core="clr-namespace:ThinkGeo.Core;assembly=ThinkGeo.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Content="Find an address or a place" Tag="search" GroupName="Mode" IsChecked="True" Margin="0,2"
                                 Checked="Mode_Checked"/>
                    <RadioButton Content="Click the map to find what is there" Tag="reverse" GroupName="Mode" Margin="0,2"
                                 Checked="Mode_Checked"/>

                    <StackPanel x:Name="SearchOptions" Margin="0,10,0,0">
                        <TextBlock Text="Address or place" FontSize="11.5"/>
                        <TextBox x:Name="TxtSearchString" Text="6101 Frisco Square Blvd, Frisco, TX 75034" Margin="0,2,0,6"/>
                        <Button Content="Search" Click="Search_Click" Margin="0,4,0,0" Padding="0,3"/>
                    </StackPanel>

                    <StackPanel x:Name="ReverseOptions" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="Location (latitude, longitude)" FontSize="11.5"/>
                        <TextBox x:Name="TxtCoordinates" Text="33.150076, -96.834530" Margin="0,2,0,6"/>
                        <TextBlock Text="Search radius (meters)" FontSize="11.5"/>
                        <TextBox x:Name="TxtSearchRadius" Text="400" Margin="0,2,0,6"/>
                        <Button Content="Search here" Click="SearchHere_Click" Margin="0,4,0,0" Padding="0,3"/>
                    </StackPanel>

                    <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox x:Name="Results" SelectionChanged="Results_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type core:CloudGeocodingLocation}">
                            <StackPanel Margin="0,2,0,4">
                                <TextBlock Text="{Binding LocationName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LocationType, StringFormat=Type: {0}}" FontSize="11" Foreground="#555B62"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type core:CloudReverseGeocodingLocation}">
                            <StackPanel Margin="0,2,0,4">
                                <TextBlock Text="{Binding Address}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LocationCategory, StringFormat=Category: {0}}" FontSize="11" Foreground="#555B62"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>
            <Image x:Name="LoadingImage" Height="64" Width="64" Visibility="Hidden" Source="..\..\Resources\loading.png"/>
        </Grid>
    </DockPanel>
</UserControl>
