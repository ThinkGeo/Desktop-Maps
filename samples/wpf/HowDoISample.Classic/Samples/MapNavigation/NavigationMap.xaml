<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.NavigationMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" x:Name="ThisControl">

    <UserControl.Resources>
        <Style x:Key="ImageButtonNoHoverStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Touch" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="TouchScreen" Content="Touch screen"
                              IsChecked="{Binding IsManipulationEnabled, ElementName=Map}"/>
                    <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Sets IsManipulationEnabled, so the map takes touch gestures. It is off by default."/>

                    <TextBlock Text="Map events" FontWeight="SemiBold" Margin="0,14,0,6"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Clear" HorizontalAlignment="Right" Padding="12,2" Margin="0,6,0,0"
                        Click="ClearLog_Click"/>
                <ListBox x:Name="LogListBox" ItemsSource="{Binding LogMessages}" FontSize="11"/>
            </DockPanel>
        </Border>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"
                                MapClick="Map_MapClick" MapDoubleClick="Map_MapDoubleClick"
                                CurrentExtentChanged="Map_CurrentExtentChanged" CurrentScaleChanged="Map_CurrentScaleChanged"
                                OverlaysDrawn="Map_OverlaysDrawn"/>

            <Button x:Name="CompassButton"
                    Style="{StaticResource ImageButtonNoHoverStyle}"
                    Width="40" Height="40"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                    RenderTransformOrigin="0.5,0.5" ToolTip="Reset north"
                    Click="CompassButton_Click">
                <Button.RenderTransform>
                    <RotateTransform Angle="{Binding ElementName=Map, Path=RotationAngle}"/>
                </Button.RenderTransform>
                <Image Source="/Resources/icon_north_arrow.png" Stretch="Fill"/>
            </Button>

            <Button x:Name="DefaultExtentButton"
                    Style="{StaticResource ImageButtonNoHoverStyle}"
                    Width="40" Height="40"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,10,0"
                    ToolTip="Back to the start"
                    Click="DefaultExtentButton_Click">
                <Image Source="/Resources/icon_globe_black.png"/>
            </Button>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <TextBlock Background="LightGray"
                           Margin="0,0,0,5" Height="30" Width="400" FontSize="20" TextAlignment="Center"
                           Text="{Binding ElementName=ThisControl, Path=TxtCoordinates}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Background="LightGray" Width="140" Height="30" FontSize="20"
                               Text="{Binding ElementName=Map, Path=RotationAngle, StringFormat={}Rotation: {0:N0}}"/>
                    <TextBlock Background="LightGray" Width="140" Height="30" FontSize="20"
                               Text="{Binding ElementName=Map, Path=CurrentZoom, StringFormat={}Zoom: {0:N2}}"/>
                    <TextBlock Background="LightGray" Width="180" Height="30" FontSize="20"
                               Text="{Binding ElementName=Map, Path=CurrentScale, StringFormat={}Scale: {0:N0}}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
