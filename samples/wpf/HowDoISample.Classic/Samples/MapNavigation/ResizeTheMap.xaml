<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.ResizeTheMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="270" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="Map resize mode" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton Content="PreserveScale" IsChecked="True" Margin="0,2" Checked="ToggleButton_OnChecked"/>
                <RadioButton Content="PreserveScaleAndCenter" Margin="0,2" Checked="ToggleButton_OnChecked"/>
                <RadioButton Content="PreserveExtent" Margin="0,2" Checked="ToggleButton_OnChecked"/>
                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Resize the window, or drag the splitter beside the code pane, and watch what the map keeps."/>
            </StackPanel>
        </Border>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
