<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.PreGenerateTileCache"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton x:Name="LocalLayers" Content="Your own layers (Frisco streets in a LayerOverlay)" GroupName="Source" IsChecked="True" Margin="0,2"
                             Checked="Source_Checked"/>
                <RadioButton x:Name="TileService" Content="A tile service (ThinkGeo Cloud raster layer)" GroupName="Source" Margin="0,2"
                             Checked="Source_Checked"/>

                <TextBlock Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Generating draws every tile of Frisco from zoom 10 to 14 and saves it in this folder. The map is set to draw only from the cache, so it shows only the tiles that were generated."/>
                <TextBlock x:Name="CacheFolderText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <WrapPanel>
                    <Button x:Name="GenerateButton" Content="Generate" Padding="12,3" Margin="0,0,6,6" Click="GenerateButton_Click"/>
                    <Button x:Name="CancelButton" Content="Cancel" Padding="12,3" Margin="0,0,6,6" IsEnabled="False" Click="CancelButton_Click"/>
                    <Button x:Name="ClearButton" Content="Clear" Padding="12,3" Margin="0,0,6,6" Click="ClearButton_Click"/>
                    <Button Content="Open Folder" Padding="12,3" Margin="0,0,6,6" Click="OpenFolderButton_Click"/>
                </WrapPanel>
                <ProgressBar x:Name="GenerateProgress" Height="8" Margin="0,8,0,0"/>

                <TextBlock x:Name="Status" Margin="0,10,0,4" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
