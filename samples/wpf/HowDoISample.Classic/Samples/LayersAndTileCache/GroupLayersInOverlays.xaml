<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.GroupLayersInOverlays"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="300" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <CheckBox x:Name="ShowPoi" Content="Points of interest: hotels and schools" IsChecked="True" Margin="0,2"
                          Checked="Group_Changed" Unchecked="Group_Changed"/>
                <CheckBox x:Name="ShowLandUse" Content="Land use: city limits and parks" IsChecked="True" Margin="0,2"
                          Checked="Group_Changed" Unchecked="Group_Changed"/>
                <CheckBox x:Name="ShowBasemap" Content="Basemap: ThinkGeo Cloud" IsChecked="True" Margin="0,2"
                          Checked="Group_Changed" Unchecked="Group_Changed"/>

                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Each group is one LayerOverlay holding its layers, so one switch shows or hides the whole group. Under every overlay is the map's BackgroundOverlay; turn the basemap off to see it, filled here with a gradient brush."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
