<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.DynamicRendering"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="270" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ElementName=YearSlider, Path=Value, StringFormat='State population in {0:F0}'}"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Slider x:Name="YearSlider" Minimum="1950" Maximum="2024" ValueChanged="YearSlider_ValueChanged"/>
                <Button Content="Play" Click="Play_Click" Margin="0,8,0,0" Padding="0,3"/>
                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Each state's circle is sized by its population in the year shown; Play runs through the years."/>
            </StackPanel>
        </Border>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
