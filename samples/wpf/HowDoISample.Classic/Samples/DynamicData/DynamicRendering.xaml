<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.DynamicRendering"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" />

        <TextBlock Text="{Binding ElementName=YearSlider, Path=Value, StringFormat='State Population in {0:F0}'}"
                   FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
            <Slider x:Name="YearSlider" Width="200" Minimum="1950" Maximum="2024"
                    VerticalAlignment="Center" ValueChanged="YearSlider_ValueChanged" />
            <Button Content="Play" Click="Play_Click" Margin="8,0,0,0" Padding="8,0" />
        </StackPanel>
    </Grid>
</UserControl>
