<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ProjectFeatures"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "subdivisions",
      "paint": {
          "fill-color": "rgba(147,112,219,0.2)",
          "fill-outline-color": "#9370DB" }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Who projects the features" FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                    <RadioButton x:Name="ModeSource" Content="The source, as it reads them" Tag="source" IsChecked="True" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ModeConvert" Content="Convert the geometry explicitly" Tag="convert" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ModeCloud" Content="The ThinkGeo Cloud" Tag="cloud" Checked="Mode_Checked"/>

                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                               Text="Frisco's subdivisions are stored in Texas state plane feet (EPSG:2276). Their source carries a ProjectionConverter, so every feature it hands out comes back in web mercator (EPSG:3857), the tiles cut from it included."/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                               Text="The WKT below is in longitude and latitude (EPSG:4326). ProjectionConverter.ConvertToExternalProjection converts it on this machine; ProjectionCloudClient.ProjectAsync asks the ThinkGeo Cloud to."/>
                </StackPanel>

                <StackPanel x:Name="WktPanel" DockPanel.Dock="Top" Margin="8,4,8,4" Visibility="Collapsed">
                    <TextBlock Text="Features, one WKT per line" FontSize="11.5"/>
                    <TextBox x:Name="TxtWkt" Height="180" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="POINT(-96.834516 33.150083)&#x0a;LINESTRING(-96.83559 33.149,-96.835866046134 33.1508413556856,-96.835793626491 33.1508974965687,-96.8336008970734 33.1511063402186,-96.83356 33.15109,-96.83328 33.14922)&#x0a;POLYGON((-96.83582 33.1508,-96.83578 33.15046,-96.83353 33.15068,-96.83358 33.15102,-96.83582 33.1508))"/>
                    <Button Content="Project and display" Height="24" Margin="0,6,0,0" Click="Project_Click"/>
                    <TextBlock x:Name="Status" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
