<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.CrossTheDateline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Unloaded="Sample_Unloaded">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "line",
      "source-layer": "corridor",
      "paint": {
          "line-color": "#6f9bff",
          "line-width": 1.2,
          "line-opacity": 0.8,
          "line-dasharray": [3, 3] }
    },

    { "type": "line",
      "source-layer": "route",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
          "line-color": "#ffffff",
          "line-width": 5,
          "line-opacity": 0.9 }
    },

    { "type": "line",
      "source-layer": "route",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
          "line-color": "#1f4fd6",
          "line-width": 2.5 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" MapUnit="Meter" Background="#0b1f33" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="LAX  →  PVG" FontWeight="SemiBold"/>
                    <TextBlock Text="Los Angeles to Shanghai Pudong, great circle" FontSize="11" Margin="0,2,0,6"/>
                    <TextBlock x:Name="PositionText" FontSize="11" FontFamily="Consolas"/>
                    <TextBlock x:Name="ProgressText" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SeamText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="A flight from Los Angeles to Shanghai crosses the antimeridian. The route, the edges of its 100-nautical-mile corridor and the aircraft's position are all stored with continuous longitudes, running past -180 the way a navigator writes them. On the globe there is no seam. In Web Mercator there is one, and the SDK folds the geometry back into the world at the tile cut, so the same data draws whole on both sides of it."/>
                    <TextBlock Text="Projection" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <RadioButton x:Name="ProjGlobe" Content="Globe" Tag="globe" IsChecked="True" Margin="0,2"
                                 Checked="Projection_Checked"/>
                    <RadioButton x:Name="ProjMercator" Content="Web Mercator (EPSG:3857)" Tag="3857" Margin="0,2"
                                 Checked="Projection_Checked"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="FlyButton" Content="Fly" Width="72" Click="Fly_Click"/>
                        <Button Content="Reset" Width="72" Margin="8,0,0,0" Click="Reset_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
