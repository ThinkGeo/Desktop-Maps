<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.CpuVsGpuProjection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:wpf="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#EAE8E2" } },

    { "type": "fill",
      "source-layer": "countries",
      "paint": {
          "fill-color": "#D8D3C6",
          "fill-outline-color": "#7A7568" }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="#F2F2F2" BorderBrush="#CCC" BorderThickness="0,0,0,1">
                    <StackPanel Margin="10,6">
                        <TextBlock Text="CPU: projected when the data is READ" FontWeight="SemiBold" />
                        <TextBlock x:Name="CpuReadout" FontFamily="Consolas" FontSize="11" Foreground="#444" Text="..." />
                    </StackPanel>
                </Border>
                <wpf:MapView x:Name="CpuMap" />
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="1,0,0,0">
                <Border DockPanel.Dock="Top" Background="#F2F2F2" BorderBrush="#CCC" BorderThickness="1,0,0,1">
                    <StackPanel Margin="10,6">
                        <TextBlock Text="GPU: projected when the map is DRAWN" FontWeight="SemiBold" />
                        <TextBlock x:Name="GpuReadout" FontFamily="Consolas" FontSize="11" Foreground="#444" Text="..." />
                    </StackPanel>
                </Border>
                <wpf:MapView x:Name="GpuMap" />
            </DockPanel>
        </Grid>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <ScrollViewer DockPanel.Dock="Top" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,6,8,4">
                    <TextBlock Text="Same data, both ways" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,10"
                               Text="One shapefile of world countries (EPSG:4326), drawn twice. The only difference is WHERE the projection happens - and everything else about the two sides follows from that." />

                    <RadioButton x:Name="RdoRobinson" Content="Robinson" IsChecked="True" Checked="Projection_Checked" Margin="0,3" />
                    <RadioButton x:Name="RdoMollweide" Content="Mollweide" Checked="Projection_Checked" Margin="0,3" />
                    <RadioButton x:Name="RdoEckert" Content="Equal Area - Eckert IV" Checked="Projection_Checked" Margin="0,3" />
                    <RadioButton x:Name="RdoCylindrical" Content="Equal Area - Cylindrical" Checked="Projection_Checked" Margin="0,3" />
                    <RadioButton x:Name="RdoEquirectangular" Content="Equirectangular" Checked="Projection_Checked" Margin="0,3" />
                    <RadioButton x:Name="RdoMercator" Content="Web Mercator" Checked="Projection_Checked" Margin="0,3" />

                    <Separator Margin="0,10,0,8" />
                    <TextBlock Text="What each side can do" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="#444" FontSize="11" Margin="0,0,0,6"
                               Text="A datum shift is arithmetic on the data, so only the side that touches the data can do it. Press this to ask both sides for a historic datum:" />
                    <Button x:Name="BtnDatum" Content="try +datum=NAD27" Click="Datum_Click" Padding="6,3" />
                    <TextBlock x:Name="DatumReadout" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10.5"
                               Foreground="#444" Margin="0,6,0,0" Text="" />

                    <Separator Margin="0,10,0,8" />
                    <TextBlock TextWrapping="Wrap" Foreground="#444" FontSize="11"
                               Text="Read the two headers as you switch. The CPU side re-reads every feature and pushes every vertex through proj4 - which is why it can honor any datum, and why the cost grows with the data. The GPU side transforms nothing: the tiles it holds are web mercator before and after, and the projection is a line of shader run per vertex per frame - which is why switching is free and why the families it supports are a closed set." />
                </StackPanel>
            </ScrollViewer>
            <TextBlock DockPanel.Dock="Top" Text="style.json - edit it; the GPU map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     Text="{StaticResource StyleJson}"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
