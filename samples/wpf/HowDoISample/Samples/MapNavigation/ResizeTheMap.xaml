<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ResizeTheMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="340" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView Grid.Column="0" x:Name="Map" SizeChanged="Map_SizeChanged"/>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#3B3F45" ResizeBehavior="PreviousAndNext"/>

        <Border Grid.Column="2" Style="{DynamicResource Shell.SamplePanel}" Width="Auto">
            <StackPanel>
                <TextBlock Text="MapResizeMode" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton Content="PreserveScale" IsChecked="True" Margin="0,2" Checked="ToggleButton_OnChecked"/>
                <RadioButton Content="PreserveScaleAndCenter" Margin="0,2" Checked="ToggleButton_OnChecked"/>
                <RadioButton Content="PreserveExtent" Margin="0,2" Checked="ToggleButton_OnChecked"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Drag the gray bar left or right to resize the map, and watch what each mode keeps: the scale, the scale and the center, or the whole extent."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
