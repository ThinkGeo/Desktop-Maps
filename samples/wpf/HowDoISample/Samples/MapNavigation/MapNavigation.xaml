<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.MapNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" x:Name="ThisControl">

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="340" Background="#F6F6F4" Padding="12"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Drag to pan, use the wheel to zoom, and right-drag to turn and tilt the map. Every event the map raises is listed below."/>

                    <TextBlock Text="View" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CompassButton" Padding="6,2" Click="CompassButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/icon_north_arrow.png" Width="18" Height="18" Stretch="Fill"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <RotateTransform Angle="{Binding ElementName=Map, Path=RotationAngle}"/>
                                    </Image.RenderTransform>
                                </Image>
                                <TextBlock Text="Reset north" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DefaultExtentButton" Padding="6,2" Margin="8,0,0,0" Click="DefaultExtentButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/icon_globe_black.png" Width="18" Height="18"/>
                                <TextBlock Text="Back to the start" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Touch" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <CheckBox x:Name="TouchScreen" Content="Touch screen"
                              IsChecked="{Binding IsManipulationEnabled, ElementName=Map}"/>
                    <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Sets IsManipulationEnabled, so the map takes touch gestures. It is off by default."/>

                    <TextBlock Text="Map events" FontWeight="SemiBold" Margin="0,14,0,6"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding ElementName=ThisControl, Path=TxtCoordinates}"/>
                    <TextBlock FontFamily="Consolas" FontSize="11"
                               Text="{Binding ElementName=Map, Path=RotationAngle, StringFormat={}Rotation: {0:N0}}"/>
                    <TextBlock FontFamily="Consolas" FontSize="11"
                               Text="{Binding ElementName=Map, Path=CurrentZoom, StringFormat={}Zoom: {0:N2}}"/>
                    <TextBlock FontFamily="Consolas" FontSize="11"
                               Text="{Binding ElementName=Map, Path=CurrentScale, StringFormat={}Scale: {0:N0}}"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Clear" HorizontalAlignment="Right" Padding="12,2" Margin="0,6,0,0"
                        Click="ClearLog_Click"/>
                <ListBox x:Name="LogListBox" ItemsSource="{Binding LogMessages}" FontSize="11"/>
            </DockPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"
                            MapClick="Map_MapClick" MapDoubleClick="Map_MapDoubleClick"
                            CurrentExtentChanged="Map_CurrentExtentChanged" CurrentScaleChanged="Map_CurrentScaleChanged"/>
    </DockPanel>
</UserControl>
