<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.MapNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" x:Name="ThisControl">

    <UserControl.Resources>
        <Style x:Key="ImageButtonNoHoverStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>

            <!-- Compass Button -->
            <Button x:Name="CompassButton"
                    Style="{StaticResource ImageButtonNoHoverStyle}"
                    Width="40" Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                    RenderTransformOrigin="0.5,0.5"
                    Click="CompassButton_Click">
                <Button.RenderTransform>
                    <RotateTransform Angle="{Binding ElementName=Map, Path=RotationAngle}"/>
                </Button.RenderTransform>
                <Image Source="/Resources/icon_north_arrow.png" Stretch="Fill"/>
            </Button>

            <!-- Default Extent Button -->
            <Button x:Name="DefaultExtentButton"
                    Style="{StaticResource ImageButtonNoHoverStyle}"
                    Width="40" Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,10,0"
                    Click="DefaultExtentButton_Click">
                <Image Source="/Resources/icon_globe_black.png"/>
            </Button>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <TextBlock Background="LightGray" IsEnabled="False"
                           VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,0,5"
                           Height="30" Width="400" FontSize="20" TextAlignment="Center"
                           Text="{Binding ElementName=ThisControl, Path=TxtCoordinates}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Background="LightGray" VerticalAlignment="Bottom"
                               Width="140" Height="30" FontSize="20"
                               Text="{Binding ElementName=Map, Path=RotationAngle, StringFormat={}Rotation: {0:N0}}"/>
                    <TextBlock Background="LightGray" VerticalAlignment="Bottom"
                               Width="140" Height="30" FontSize="20"
                               Text="{Binding ElementName=Map, Path=CurrentZoom, StringFormat={}Zoom: {0:N2}}"/>
                    <TextBlock Background="LightGray" VerticalAlignment="Bottom"
                               Width="180" Height="30" FontSize="20"
                               Text="{Binding ElementName=Map, Path=CurrentScale, StringFormat={}Scale: {0:N0}}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Background="DimGray" Margin="10">
            <TextBlock Text="Camera" FontSize="16" FontWeight="Bold" Foreground="WhiteSmoke" Margin="0,0,0,6"/>

            <CheckBox x:Name="BuildingCheckBox"
                      Content="3D Buildings"
                      IsChecked="True"
                      Checked="BuildingCheckBox_CheckedChanged"
                      Unchecked="BuildingCheckBox_CheckedChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Pitch" Foreground="WhiteSmoke" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="PitchSlider" Minimum="0" Maximum="80" Value="0" Width="150"
                        VerticalAlignment="Center" ValueChanged="PitchSlider_ValueChanged"/>
                <TextBlock x:Name="PitchValueText" Text="0°" Foreground="WhiteSmoke" Width="36"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <Button x:Name="DarkThemeButton" Content="Dark Theme" Height="28" Margin="0,10,0,0"
                    Click="DarkThemeButton_OnClick"/>
        </StackPanel>
    </Grid>
</UserControl>
