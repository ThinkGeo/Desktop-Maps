<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.StyleLayerToggles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>
        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">
                    <TextBlock x:Name="LayerCount" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <ItemsControl x:Name="LayerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="True" Margin="2,1,0,1"
                                          Checked="Layer_Changed" Unchecked="Layer_Changed">
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Id, Mode=OneWay}"/>
                                        <Run Text="{Binding Type, Mode=OneWay, StringFormat=' ({0})'}"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
