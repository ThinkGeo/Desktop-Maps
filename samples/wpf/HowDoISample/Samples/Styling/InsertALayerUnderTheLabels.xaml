<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.InsertALayerUnderTheLabels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>

        <Border Style="{DynamicResource Shell.MapCard}" Margin="72,12,12,12"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Text="aerial -> roads -> white wash -> labels: the wash mutes the imagery and the roads, the labels stay crisp. An overlay would cover the labels too."/>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="wash opacity:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="WashReadout" DockPanel.Dock="Right" Width="40" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <Slider x:Name="WashSlider" Minimum="0" Maximum="0.9" Value="0.45"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
