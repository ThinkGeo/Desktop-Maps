<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.InsertALayerUnderTheLabels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Background="#F6F6F4" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Padding="12">
            <StackPanel>
                <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="aerial (raster) -> roads (vector) -> white wash (fill) -> labels (vector). The wash mutes the imagery and the roads while the labels stay crisp; an overlay could only ever sit above everything, labels included."/>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="wash opacity:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="WashReadout" DockPanel.Dock="Right" Width="40" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <Slider x:Name="WashSlider" Minimum="0" Maximum="0.9" Value="0.45"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
