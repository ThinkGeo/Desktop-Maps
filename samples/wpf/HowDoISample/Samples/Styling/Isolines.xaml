<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Isolines"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="DataPointsStyle" xml:space="preserve">{
  "layers": [

    { "id": "data-points",
      "type": "circle",
      "source-layer": "points",
      "paint": {
          "circle-radius": 5,
          "circle-color": "#000000",
          "circle-stroke-color": "#FFFFFF",
          "circle-stroke-width": 2 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Background="#F6F6F4" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Padding="12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <CheckBox Content="fill bands" Margin="0,2"
                              Checked="FillToggle_Changed" Unchecked="FillToggle_Changed"/>
                    <CheckBox Content="labels" IsChecked="True" Margin="0,2"
                              Checked="LabelToggle_Changed" Unchecked="LabelToggle_Changed"/>
                    <CheckBox x:Name="PointToggle" Content="data points" IsChecked="True" Margin="0,2"
                              Checked="PointToggle_Changed" Unchecked="PointToggle_Changed"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="levels" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <Slider Grid.Row="0" Grid.Column="1" x:Name="LevelSlider" Minimum="2" Maximum="60" Value="25"
                            VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="LevelSlider_ValueChanged"/>

                    <TextBlock Grid.Row="1" Text="line width" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <Slider Grid.Row="1" Grid.Column="1" x:Name="WidthSlider" Minimum="1" Maximum="8" Value="3"
                            VerticalAlignment="Center" ValueChanged="WidthSlider_ValueChanged"/>

                    <TextBlock Grid.Row="2" Text="interpolation power" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <Slider Grid.Row="2" Grid.Column="1" x:Name="PowerSlider" Minimum="1" Maximum="4" Value="2"
                            VerticalAlignment="Center" ValueChanged="PowerSlider_ValueChanged"/>

                    <TextBlock Grid.Row="3" Text="search radius" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <!-- In widths of the data area; 0 uses every point. -->
                    <Slider Grid.Row="3" Grid.Column="1" x:Name="RadiusSlider" Minimum="0" Maximum="1.5" Value="0"
                            VerticalAlignment="Center" ValueChanged="RadiusSlider_ValueChanged"/>
                </Grid>

                <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                           Text="drag the sliders - updates land on the next frame"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
