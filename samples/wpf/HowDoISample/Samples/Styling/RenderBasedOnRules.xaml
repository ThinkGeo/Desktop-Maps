<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.RenderBasedOnRules"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="RuleMatch" xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#DDE8F0" } },

    { "type": "fill",
      "source-layer": "Countries02",
      "paint": {
          "fill-outline-color": "#FFFFFF",
          "fill-color": ["match", ["get", "CURR_TYPE"],
              "Dollar", "rgba(31,119,180,0.8)",
              "Franc", "rgba(44,160,44,0.8)",
              "Pound", "rgba(214,39,40,0.8)",
              "Peso", "rgba(148,103,189,0.8)",
              "rgba(233,232,214,0.8)"] }
    }
  ]
}</sys:String>

        <sys:String x:Key="RuleStep" xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#DDE8F0" } },

    { "type": "fill",
      "source-layer": "Countries02",
      "paint": {
          "fill-outline-color": "#FFFFFF",
          "fill-color": ["step", ["get", "POP_CNTRY"],
              "rgba(233,232,214,0.85)",
              1000000, "rgba(253,208,162,0.85)",
              10000000, "rgba(253,141,60,0.85)",
              50000000, "rgba(217,71,1,0.85)",
              200000000, "rgba(127,39,4,0.85)"] }
    }
  ]
}</sys:String>

        <sys:String x:Key="RuleFilter" xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#DDE8F0" } },

    { "type": "fill",
      "source-layer": "Countries02",
      "paint": {
          "fill-color": "rgba(233,232,214,0.8)",
          "fill-outline-color": "#FFFFFF" }
    },

    { "type": "fill",
      "source-layer": "Countries02",
      "filter": ["==", ["get", "LANDLOCKED"], "Y"],
      "paint": {
          "fill-color": "rgba(46,139,87,0.8)",
          "fill-outline-color": "#FFFFFF" }
    }
  ]
}</sys:String>

        <sys:String x:Key="RuleCase" xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#DDE8F0" } },

    { "type": "fill",
      "source-layer": "Countries02",
      "paint": {
          "fill-outline-color": "#FFFFFF",
          "fill-color": ["case",
              ["all", [">", ["get", "POP_CNTRY"], 10000000],
                      ["==", ["get", "LANDLOCKED"], "Y"]],
              "rgba(255,255,0,0.8)",
              "rgba(233,232,214,0.8)"] }
    }
  ]
}</sys:String>

        <sys:String x:Key="RuleZoom" xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#DDE8F0" } },

    { "type": "fill",
      "source-layer": "Countries02",
      "paint": { "fill-color": "rgba(233,232,214,0.8)" } },

    { "type": "line",
      "source-layer": "Countries02",
      "paint": {
          "line-color": "#8C8C7A",
          "line-width": ["interpolate", ["linear"], ["zoom"],
              1, 0.5,
              6, 4] }
    },

    { "type": "symbol",
      "source-layer": "Countries02",
      "minzoom": 2,
      "maxzoom": 4,
      "layout": {
          "text-field": ["get", "ISO_3DIGIT"],
          "text-font": ["Noto Sans Bold"],
          "text-size": 11 },
      "paint": { "text-color": "#5A5A50" }
    },

    { "type": "symbol",
      "source-layer": "Countries02",
      "minzoom": 4,
      "layout": {
          "text-field": ["get", "CNTRY_NAME"],
          "text-font": ["Noto Sans Regular"],
          "text-size": ["step", ["zoom"],
              12,
              6, 15] },
      "paint": { "text-color": "#333333" }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock DockPanel.Dock="Top" Text="style.json - pick a rule, or edit it; the map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                <RadioButton x:Name="MatchRule" Content="Values - match" Tag="RuleMatch" IsChecked="True" Checked="Rule_Checked"/>
                <RadioButton x:Name="StepRule" Content="Ranges - step" Tag="RuleStep" Checked="Rule_Checked"/>
                <RadioButton x:Name="FilterRule" Content="Only what passes - filter" Tag="RuleFilter" Checked="Rule_Checked"/>
                <RadioButton x:Name="CaseRule" Content="Any condition - case" Tag="RuleCase" Checked="Rule_Checked"/>
                <RadioButton x:Name="ZoomRule" Content="By zoom level - minzoom, maxzoom and zoom" Tag="RuleZoom" Checked="Rule_Checked"/>
            </StackPanel>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     Text="{StaticResource RuleMatch}"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
