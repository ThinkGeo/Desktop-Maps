<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.RenderBasedOnCode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="12,8"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeClock" Content="The clock - day and night circles" Tag="Clock"
                                 IsChecked="True" Checked="Mode_Checked" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ModeRamp" Content="The data - a choropleth ramp" Tag="Ramp"
                                 Checked="Mode_Checked" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="ClockRow">
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="UTC:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="HourSlider" Minimum="0" Maximum="24" Width="320" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HourLabel" Width="74" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                               Text="A style document has no clock. Each timezone is a pair of circle layers built in code, one for day and one for night, and the UTC hour switches which of the two is visible. A paint is fixed once its tile is built, so switching visibility is how the map changes with time without rebuilding a tile. Drag the slider to take over."/>
                </StackPanel>
                <TextBlock x:Name="RampText" Visibility="Collapsed" Margin="0,4,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="A paint lambda reads each state's 1990 population density and answers with a color from a five-step ramp, with the column name checked by the compiler. It runs when the tiles are built, not on every frame. The fill and its white outline are inserted above the basemap's own fills, so the roads and labels stay on top."/>
            </StackPanel>
        </Border>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
