<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.RenderPointsLinesAndPolygons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel.Wide}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="style.json - edit it and the map follows"
                           FontWeight="SemiBold" FontSize="11.5" Margin="0,6,0,4"/>
                <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="0,4,0,6"
                           TextWrapping="Wrap" Foreground="LightGreen"/>
                <Button DockPanel.Dock="Bottom" Content="Export PDF" Click="ExportPdf_Click"
                        HorizontalAlignment="Left" Padding="12,3" Margin="0,4,0,0"/>
                <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                         AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" FontSize="11.5" Padding="6"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#1F2226" } },

    { "type": "fill",
      "source-layer": "Parks",
      "paint": {
          "fill-color": "#B4E0B6",
          "fill-outline-color": "#696969" }
    },

    { "type": "line",
      "source-layer": "Streets",
      "paint": {
          "line-color": "#696969",
          "line-width": 6 }
    },

    { "type": "line",
      "source-layer": "Streets",
      "paint": {
          "line-color": "#F5F5F5",
          "line-width": 4 }
    },

    { "type": "circle",
      "source-layer": "Hotels",
      "paint": {
          "circle-radius": 4,
          "circle-color": "#E8685E" }
    },

    { "type": "symbol",
      "source-layer": "Streets",
      "layout": {
          "symbol-placement": "line",
          "text-field": ["get", "FULL_NAME"],
          "text-font": ["Noto Sans Bold"],
          "text-size": 11 },
      "paint": { "text-color": "#AFC2FF" }
    },

    { "type": "symbol",
      "source-layer": "Parks",
      "layout": {
          "text-field": ["get", "NAME"],
          "text-font": ["Noto Sans Bold"],
          "text-size": 11 },
      "paint": { "text-color": "#006400" }
    },

    { "type": "symbol",
      "source-layer": "Hotels",
      "layout": {
          "text-field": ["get", "NAME"],
          "text-font": ["Noto Sans Bold"],
          "text-size": 11,
          "text-offset": [0, 0.5],
          "text-anchor": "top" },
      "paint": { "text-color": "#FF8A80" }
    }
  ]
}</TextBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
