<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.HatchStyles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="12,8"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hatch pattern:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="HatchPicker" Width="190" VerticalAlignment="Center"/>
                    <Border x:Name="Swatch" Width="44" Height="26" Margin="10,0,0,0" VerticalAlignment="Center"
                            BorderBrush="#AAAAAA" BorderThickness="1" Background="White"/>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Every GeoHatchStyle is stroked into a small image, registered with MapStyle.Images, and named by fill-pattern. The swatch is that image, tiled at the size the map draws it. Picking a row rewrites fill-pattern in the document beside the map."/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

            <DockPanel Grid.Column="1" Background="#F6F6F4">
                <TextBlock DockPanel.Dock="Top" Text="style.json - edit it and the map follows"
                           FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
                <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                           TextWrapping="Wrap" Foreground="DarkGreen"/>
                <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                         AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" FontSize="11.5" Padding="6"
                         TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#DDE8F0" } },

    { "type": "fill",
      "source-layer": "Parks",
      "paint": { "fill-pattern": "hatch-cross" } },

    { "type": "line",
      "source-layer": "Parks",
      "paint": {
          "line-color": "#0000FF",
          "line-width": 2.5 }
    },

    { "type": "symbol",
      "source-layer": "Parks",
      "layout": {
          "text-field": ["get", "NAME"],
          "text-font": ["Noto Sans Bold"],
          "text-size": 11 },
      "paint": { "text-color": "#145A28" }
    }
  ]
}</TextBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
