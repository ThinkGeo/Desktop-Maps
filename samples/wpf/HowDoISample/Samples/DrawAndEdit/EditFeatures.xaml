<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.EditFeatures"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenChecked"/>
        <Style x:Key="Instruction" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="18,2,0,6"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Style="{DynamicResource Shell.SamplePanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <RadioButton x:Name="EditShape" Content="Edit shapes" IsChecked="True" Margin="0,2"
                                 Checked="EditShape_OnChecked" Unchecked="EditShape_OnUnchecked"/>
                    <TextBlock Style="{StaticResource Instruction}"
                               Visibility="{Binding IsChecked, ElementName=EditShape, Converter={StaticResource VisibleWhenChecked}}"
                               Text="Use the handles to move, rotate or scale a shape. Drag a vertex to move it, click a segment to add a vertex, double-click a vertex to remove it."/>

                    <RadioButton x:Name="DrawPoint" Content="Draw points" Margin="0,2" Click="DrawPoint_Click"/>
                    <TextBlock Style="{StaticResource Instruction}"
                               Visibility="{Binding IsChecked, ElementName=DrawPoint, Converter={StaticResource VisibleWhenChecked}}"
                               Text="Click the map to add a point. Hold the middle mouse button to pan."/>

                    <RadioButton x:Name="DrawLine" Content="Draw lines" Margin="0,2" Click="DrawLine_Click"/>
                    <TextBlock Style="{StaticResource Instruction}"
                               Visibility="{Binding IsChecked, ElementName=DrawLine, Converter={StaticResource VisibleWhenChecked}}"
                               Text="Click to add vertices, double-click to finish the line; right-click takes the last vertex back, Esc drops the line. Hold the middle mouse button to pan, and Shift to keep a segment north-south or east-west."/>

                    <RadioButton x:Name="DrawPolygon" Content="Draw polygons" Margin="0,2" Click="DrawPolygon_Click"/>
                    <TextBlock Style="{StaticResource Instruction}"
                               Visibility="{Binding IsChecked, ElementName=DrawPolygon, Converter={StaticResource VisibleWhenChecked}}"
                               Text="Click to add vertices, double-click to finish the polygon; right-click takes the last vertex back, Esc drops the polygon. Hold the middle mouse button to pan, and Shift to keep a segment north-south or east-west."/>

                    <RadioButton x:Name="NavModeRadio" Content="Navigate" Margin="0,2" Click="NavMode_Click"/>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavModeRadio, Converter={StaticResource VisibleWhenChecked}}">
                        <TextBlock Style="{StaticResource Instruction}" Text="The shapes are saved to a layer; drag and wheel pan and zoom the map."/>
                        <CheckBox x:Name="DeleteShape" Content="Click a shape to delete it" Margin="18,0,0,6"/>
                    </StackPanel>

                    <TextBlock Text="Measure" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <TextBlock x:Name="MeasureResult" Text="Drag a vertex or draw a shape." FontSize="11"/>

                    <TextBlock Text="Edit events" FontWeight="SemiBold" Margin="0,12,0,6"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Clear" HorizontalAlignment="Right" Padding="12,2" Margin="0,6,0,0"
                        Click="ClearLog_Click"/>
                <ListBox x:Name="LogListBox" ItemsSource="{Binding LogMessages}" FontSize="11"/>
            </DockPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>
    </DockPanel>
</UserControl>
