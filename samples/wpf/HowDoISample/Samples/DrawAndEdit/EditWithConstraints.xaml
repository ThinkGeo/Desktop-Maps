<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.EditWithConstraints"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenChecked"/>
        <Style x:Key="Instruction" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="18,2,0,6"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Style="{DynamicResource Shell.SamplePanel}">
            <StackPanel>
                <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <RadioButton x:Name="EditShapes" Content="Edit shapes" IsChecked="True" Margin="0,2" Checked="EditShapes_Checked"/>
                <TextBlock Style="{StaticResource Instruction}"
                           Visibility="{Binding IsChecked, ElementName=EditShapes, Converter={StaticResource VisibleWhenChecked}}"
                           Text="The upper shape is tagged as a rectangle: drag any corner and its two neighbors follow. Click a segment to add a vertex; the click is rejected within 300 m on the ground of an existing vertex. After dragging a vertex, its coordinates appear below - correct them and click Apply to place it exactly."/>

                <RadioButton x:Name="DrawPolygon" Content="Draw polygon" Margin="0,2" Click="DrawPolygon_Click"/>
                <TextBlock Style="{StaticResource Instruction}"
                           Visibility="{Binding IsChecked, ElementName=DrawPolygon, Converter={StaticResource VisibleWhenChecked}}"
                           Text="Click to add vertices; a click within 300 m on the ground of the previous vertex is rejected. Double-click to finish, Esc to cancel, right-click to undo the last vertex. Switch back to Edit shapes to edit the result."/>

                <TextBlock Text="Moved vertex (EPSG:3857)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" x:Name="VertexX" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox Grid.Column="3" x:Name="VertexY" VerticalAlignment="Center"/>
                </Grid>
                <Button Content="Apply exact coordinates" Margin="0,8,0,0" Padding="4" Click="ApplyCoordinates_Click"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
