<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Terrain3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- The relief shading layer, reading the DEM that SetTerrain(DemSource) declares under "terrain-dem". -->
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "hillshade",
      "source": "terrain-dem",
      "paint": { "hillshade-exaggeration": 0.4 } }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>

        <Border Grid.Column="1" Background="#F6F6F4" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Padding="12">
            <StackPanel>
                <CheckBox x:Name="TerrainToggle" Content="Terrain" IsChecked="True"
                          Checked="TerrainToggle_Checked" Unchecked="TerrainToggle_Unchecked"/>
                <TextBlock x:Name="ProfileText" Text="Click two points for an elevation profile."
                           TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- The profile chart: distance along the line across, elevation up. -->
                <Border x:Name="ChartPanel" Visibility="Collapsed" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Padding="8" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="ChartTitle" FontSize="11" Margin="0,0,0,4"/>
                        <Canvas x:Name="Chart" Width="296" Height="110" ClipToBounds="True">
                            <Polyline x:Name="ChartLine" Stroke="DarkGreen" StrokeThickness="1.5"/>
                        </Canvas>
                    </StackPanel>
                </Border>

                <TextBlock Foreground="#606060" TextWrapping="Wrap" FontSize="11" Margin="0,16,0,0"
                           Text="Elevation: AWS open terrain tiles (terrarium encoding). Imagery: ThinkGeo Cloud aerial."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
