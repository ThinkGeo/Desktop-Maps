<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Terrain3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- The relief shading layer, reading the DEM that SetTerrain(DemSource) declares under "terrain-dem". -->
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "hillshade",
      "source": "terrain-dem",
      "paint": { "hillshade-exaggeration": 0.4 } }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>

            <!-- The profile chart: distance along the line across, elevation up. -->
            <Border x:Name="ChartPanel" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,12" Padding="8" Background="#E6FFFFFF" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="ChartTitle" FontSize="11" Margin="0,0,0,4"/>
                    <Canvas x:Name="Chart" Width="320" Height="110" ClipToBounds="True">
                        <Polyline x:Name="ChartLine" Stroke="DarkGreen" StrokeThickness="1.5"/>
                    </Canvas>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" Background="#F6F6F4">
            <CheckBox x:Name="TerrainToggle" Content="Terrain" IsChecked="True" Margin="8,8,8,2"
                      Checked="TerrainToggle_Checked" Unchecked="TerrainToggle_Unchecked"/>
            <TextBlock x:Name="ProfileText" Text="Click two points for an elevation profile."
                       TextWrapping="Wrap" Margin="8,8,8,0"/>
            <TextBlock Foreground="#606060" TextWrapping="Wrap" FontSize="11" Margin="8,16,8,0"
                       Text="Elevation: AWS open terrain tiles (terrarium encoding). Imagery: ThinkGeo Cloud aerial."/>
        </StackPanel>
    </Grid>
</UserControl>
