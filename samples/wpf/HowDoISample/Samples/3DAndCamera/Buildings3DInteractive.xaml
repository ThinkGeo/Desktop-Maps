<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Buildings3DInteractive"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
        <!-- The tilt is a property of the map, so a plain Slider bound to it is the control:
             it drives the camera and follows the right-drag gesture. -->
        <Slider Orientation="Vertical" Height="200" Maximum="60" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,16,0" ToolTip="Tilt" Value="{Binding TiltAngle, ElementName=Map, Mode=TwoWay}"/>
    </Grid>
</UserControl>
