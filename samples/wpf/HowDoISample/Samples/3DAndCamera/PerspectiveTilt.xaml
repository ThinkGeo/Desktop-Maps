<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.PerspectiveTilt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel}">
            <StackPanel>
                <TextBlock Text="Basemap" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <RadioButton x:Name="TiltVector" Content="Vector tiles - midtown Manhattan" IsChecked="True" Margin="0,2,0,2" Checked="Basemap_Checked"/>
                <RadioButton x:Name="TiltRaster" Content="Raster tiles - San Francisco Bay" Margin="0,2,0,2" Checked="Basemap_Checked"/>

                <CheckBox x:Name="BuildingCheckBox" Content="Buildings from the basemap style" IsChecked="True" Margin="0,10,0,2"
                          IsEnabled="{Binding IsChecked, ElementName=TiltVector}"
                          Checked="BuildingCheckBox_Changed" Unchecked="BuildingCheckBox_Changed"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="18,0,0,0"
                           Text="The vector style already carries a fill-extrusion layer for buildings; the check box draws or skips it. It does not extrude footprints of your own."/>

                <TextBlock Text="Tilt" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <Slider Maximum="60" Value="{Binding TiltAngle, ElementName=Map, Mode=TwoWay}"/>

                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,16,0,0"
                           Text="Right-drag tilts. Left-drag pans, and the ground you grabbed stays under the cursor. Alt and left-drag rotates; the wheel zooms. None of that is in this sample - it is what the MapView does once IsTiltEnabled is set."/>

                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"
                           Text="Raster tiles tilt exactly as vector tiles do. What vector adds is labels that stay upright, tiles that get coarser toward the horizon, and buildings that stand up."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
