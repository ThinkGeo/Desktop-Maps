<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.LaneLevelNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- One vertical level of the lane map. The code draws these layers once per level,
             ground first, so a road passing over another is drawn on top of it. -->
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "drivable",
      "paint": { "fill-color": "#1b1f24" } },

    { "type": "fill",
      "source-layer": "lane",
      "paint": { "fill-color": "#23282e" } },

    { "type": "fill",
      "source-layer": "route_lane",
      "paint": { "fill-color": "#28395c" } },

    { "type": "line",
      "source-layer": "lane_edge",
      "paint": {
          "line-color": "#0a0c0f",
          "line-opacity": 0.95,
          "line-width": ["interpolate", ["exponential", 2], ["zoom"], 15, 1.2, 17, 2, 18, 3, 19, 5, 20, 9, 21, 15] }
    },

    { "type": "line",
      "source-layer": "lane_edge",
      "paint": {
          "line-color": "#b9c1c9",
          "line-width": ["interpolate", ["exponential", 2], ["zoom"], 15, 0.5, 17, 0.8, 18, 1.2, 19, 2, 20, 4, 21, 7] }
    },

    { "type": "line",
      "source-layer": "lane_marking_dashed",
      "paint": {
          "line-color": "#ffffff",
          "line-dasharray": [3, 3.5],
          "line-width": ["interpolate", ["exponential", 2], ["zoom"], 15, 0.6, 17, 1.0, 18, 1.6, 19, 3, 20, 6, 21, 11] }
    },

    { "type": "line",
      "source-layer": "lane_marking_solid",
      "paint": {
          "line-color": "#ffffff",
          "line-width": ["interpolate", ["exponential", 2], ["zoom"], 15, 0.7, 17, 1.1, 18, 1.8, 19, 3.5, 20, 7, 21, 12] }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" MapUnit="Meter" Background="#101317" SizeChanged="Map_SizeChanged"/>

        <!-- The navigation card: the lane the vehicle is in, the lane change or
             intersection ahead and how far away it is, read off the route's lane data. -->
        <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16" Width="340" Padding="18"
                CornerRadius="16" Background="#E6111917" BorderBrush="#33584F" BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="StreetText" Foreground="#7EF2D9" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="InstructionText" Foreground="White" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,2"/>
                <TextBlock x:Name="NextText" Foreground="#C9D4D0" FontSize="14"/>
                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <TextBlock x:Name="SpeedText" Foreground="#C9D4D0" FontSize="14"/>
                    <TextBlock x:Name="ProgressText" Foreground="#C9D4D0" FontSize="14" DockPanel.Dock="Right"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Image Grid.Column="0" Source="/Resources/icon_north_arrow.png"
               VerticalAlignment="Top" HorizontalAlignment="Right"
               Width="40" Height="40" Margin="5"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <RotateTransform Angle="{Binding ElementName=Map, Path=RotationAngle}"/>
            </Image.RenderTransform>
        </Image>

        <Border Grid.Column="1" Background="#F6F6F4" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Padding="12">
            <StackPanel>
                <TextBlock Text="Wolfsburg, OpenDRIVE HD map" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatsText" Text="" Foreground="#555B62" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="AttributionText" Text="" Foreground="#555B62" FontSize="11" TextWrapping="Wrap"/>

                <DockPanel Margin="0,12,0,0">
                    <TextBlock Text="Pitch" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="PitchValueText" DockPanel.Dock="Right" Text="58°" Width="36"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Slider x:Name="PitchSlider" Minimum="0" Maximum="60" Value="58"
                            VerticalAlignment="Center" ValueChanged="PitchSlider_ValueChanged"/>
                </DockPanel>
                <Button x:Name="OverviewButton" Content="Overview Mode" Height="28" Margin="0,8,0,0" Click="OverviewButton_OnClick"/>
                <TextBlock Text="Wheel: zoom   |   right-drag: tilt   |   Alt+drag: rotate"
                           Foreground="#555B62" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
