<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Popups"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>

        <Border Style="{DynamicResource Shell.MapCard}" Margin="72,12,12,12"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <CheckBox x:Name="ShowHotels" Content="A popup on every hotel" IsChecked="True"
                          Checked="ShowHotels_Changed" Unchecked="ShowHotels_Changed"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Click the map: a popup opens there with its latitude and longitude, replacing the previous one."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
