<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Popups"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="Popups" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox x:Name="ShowHotels" Content="A popup on every hotel" IsChecked="True" Margin="0,2"
                          Checked="ShowHotels_Changed" Unchecked="ShowHotels_Changed"/>
                <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Click the map: a popup opens at that point with its latitude and longitude, and the one from the previous click is removed."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>
    </DockPanel>
</UserControl>
