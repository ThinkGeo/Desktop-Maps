<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ClusterMarkers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Ellipse x:Key="SightingDot" x:Shared="False" Width="12" Height="12" Fill="#A0522D" Stroke="White" StrokeThickness="2"/>
        <Grid x:Key="ClusterDisc" x:Shared="False" Cursor="Hand">
            <Ellipse Fill="#D82E6EA6" Stroke="White" StrokeThickness="2"/>
            <TextBlock Text="{Binding}" Foreground="White" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="340" Background="#F6F6F4" Padding="12"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                       Text="The sightings are bucketed on a screen-pixel grid for the current view, one marker per bucket. Zoom and the clusters split; click one to zoom into it."/>
        </Border>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
