<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ClusterMarkers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Ellipse x:Key="SightingDot" x:Shared="False" Width="12" Height="12" Fill="#A0522D" Stroke="White" StrokeThickness="2"/>
        <Grid x:Key="ClusterDisc" x:Shared="False" Cursor="Hand">
            <Ellipse Fill="#D82E6EA6" Stroke="White" StrokeThickness="2"/>
            <TextBlock Text="{Binding}" Foreground="White" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </UserControl.Resources>

    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>

        <Border Style="{DynamicResource Shell.MapCard}" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Text="Sightings are bucketed on a screen-pixel grid, one marker per bucket. Zoom and the clusters split; click one to zoom into it."/>
        </Border>
    </Grid>
</UserControl>
