<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Markers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Style="{DynamicResource Shell.SamplePanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Mouse" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <RadioButton x:Name="AddMode" Content="Click the map to add a marker" IsChecked="True" Margin="0,2"
                                 Checked="Mode_Checked"/>
                    <RadioButton x:Name="DragMode" Content="Drag a marker to move it" Margin="0,2"
                                 Checked="Mode_Checked"/>
                    <RadioButton x:Name="RemoveMode" Content="Click a marker to remove it" Margin="0,2"
                                 Checked="Mode_Checked"/>

                    <TextBlock Text="Tilt" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <Slider Maximum="60" Value="{Binding TiltAngle, ElementName=Map, Mode=TwoWay}"/>

                    <TextBlock Text="Any WPF element" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Text="The pulsing red dot is a marker whose Content is a WPF control with its own storyboard, instead of an image."/>
                    <CheckBox x:Name="Animate" Content="Animate it" IsChecked="True" Margin="0,6,0,0"
                              Checked="Animate_Changed" Unchecked="Animate_Changed"/>

                    <TextBlock Text="Marker events" FontWeight="SemiBold" Margin="0,14,0,6"/>
                </StackPanel>
                <ListBox x:Name="LogListBox" ItemsSource="{Binding LogMessages}" FontSize="11"/>
            </DockPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>
    </DockPanel>
</UserControl>
