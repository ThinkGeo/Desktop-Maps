<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ColorUtilities"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="270" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="Color family" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CboColorType" SelectionChanged="CboColorType_SelectionChanged">
                    <ComboBoxItem IsSelected="True">Hue</ComboBoxItem>
                    <ComboBoxItem>Triad</ComboBoxItem>
                    <ComboBoxItem>Tetrad</ComboBoxItem>
                    <ComboBoxItem>Quality</ComboBoxItem>
                    <ComboBoxItem>Analogous</ComboBoxItem>
                    <ComboBoxItem>Contrasting</ComboBoxItem>
                    <ComboBoxItem>Complementary</ComboBoxItem>
                </ComboBox>
                <TextBlock x:Name="TxtColorCategoryDescription" Margin="0,4,0,10" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Get a family of colors with the same hue and sequential variances in lightness and saturation"/>

                <TextBlock Text="Base color" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <RadioButton x:Name="RdoDefaultColor" GroupName="SelectedColor" IsChecked="True" Content="One of these:" Margin="0,2"/>
                <ComboBox x:Name="CboDefaultColor" Margin="18,2,0,4">
                    <ComboBoxItem IsSelected="True">Red</ComboBoxItem>
                    <ComboBoxItem>Orange</ComboBoxItem>
                    <ComboBoxItem>Yellow</ComboBoxItem>
                    <ComboBoxItem>Green</ComboBoxItem>
                    <ComboBoxItem>Blue</ComboBoxItem>
                    <ComboBoxItem>Purple</ComboBoxItem>
                </ComboBox>
                <RadioButton x:Name="RdoSpecificColor" GroupName="SelectedColor" Content="This HTML color:" Margin="0,2"/>
                <TextBox x:Name="TxtSpecificColor" Text="#AB2567" Margin="18,2,0,4"/>
                <RadioButton x:Name="RdoRandomColor" GroupName="SelectedColor" Content="Let the service choose" Margin="0,2"/>

                <Button Content="Generate" Click="GenerateColors_Click" Margin="0,10,0,0" Padding="0,3"/>
                <TextBlock x:Name="Status" Margin="0,8,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
            <Image x:Name="LoadingImage" Height="64" Width="64" Visibility="Hidden" Source="..\..\Resources\loading.png"/>
        </Grid>
    </DockPanel>
</UserControl>
