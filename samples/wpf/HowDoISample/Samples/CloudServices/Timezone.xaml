<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Timezone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>
        <Image x:Name="LoadingImage" Height="64" Width="64" Visibility="Visible" Source="..\..\Resources\loading.png"/>

        <Border Style="{DynamicResource Shell.MapCard}" Margin="72,12,12,12"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Click the map to get the time zone there" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="Status" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
