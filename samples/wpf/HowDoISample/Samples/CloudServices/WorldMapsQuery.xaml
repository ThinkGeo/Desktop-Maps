<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.WorldMapsQuery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="270" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="Query layer" FontSize="11.5"/>
                <ComboBox x:Name="CboQueryLayer" Margin="0,2,0,6">
                    <ComboBoxItem IsSelected="True">Buildings</ComboBoxItem>
                    <ComboBoxItem>Countries</ComboBoxItem>
                    <ComboBoxItem>States</ComboBoxItem>
                    <ComboBoxItem>Roads</ComboBoxItem>
                    <ComboBoxItem>Rail</ComboBoxItem>
                    <ComboBoxItem>Addresses</ComboBoxItem>
                    <ComboBoxItem>Cities</ComboBoxItem>
                    <ComboBoxItem>Land-Use</ComboBoxItem>
                    <ComboBoxItem>Places</ComboBoxItem>
                    <ComboBoxItem>POIs</ComboBoxItem>
                    <ComboBoxItem>Transport</ComboBoxItem>
                    <ComboBoxItem>Water</ComboBoxItem>
                    <ComboBoxItem>Waterways</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Query type" FontSize="11.5"/>
                <ComboBox x:Name="CboQueryType" Margin="0,2,0,6">
                    <ComboBoxItem>Containing</ComboBoxItem>
                    <ComboBoxItem>Nearest</ComboBoxItem>
                    <ComboBoxItem IsSelected="True">Intersecting</ComboBoxItem>
                    <ComboBoxItem>Overlapping</ComboBoxItem>
                    <ComboBoxItem>Within</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Maximum results" FontSize="11.5"/>
                <DockPanel Margin="0,2,0,8">
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                               Text="{Binding ElementName=MaxResults, Path=Value}"/>
                    <Slider x:Name="MaxResults" Minimum="10" Maximum="1000" Value="100"
                            TickFrequency="50" IsSnapToTickEnabled="True"/>
                </DockPanel>
                <Button Content="Draw a point and query" Click="DrawPoint_Click" Margin="0,2" Padding="0,3"/>
                <Button Content="Draw a line and query" Click="DrawLine_Click" Margin="0,2" Padding="0,3"/>
                <Button Content="Draw an area and query" Click="DrawPolygon_Click" Margin="0,2" Padding="0,3"/>
                <TextBlock x:Name="Status" Margin="0,8,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
            <Image x:Name="LoadingImage" Height="64" Width="64" Visibility="Hidden" Source="..\..\Resources\loading.png"/>
        </Grid>
    </DockPanel>
</UserControl>
