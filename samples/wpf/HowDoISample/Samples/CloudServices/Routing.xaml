<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Routing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             xmlns:core="clr-namespace:ThinkGeo.Core;assembly=ThinkGeo.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Style="{DynamicResource Shell.SamplePanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Content="Route through the stops in order" Tag="route" GroupName="Mode" IsChecked="True" Margin="0,2"
                                 Checked="Mode_Checked"/>
                    <RadioButton Content="Visit the stops in the shortest order" Tag="optimized" GroupName="Mode" Margin="0,2"
                                 Checked="Mode_Checked"/>
                    <RadioButton Content="How far you can drive from a point" Tag="area" GroupName="Mode" Margin="0,2"
                                 Checked="Mode_Checked"/>

                    <TextBlock x:Name="Status" Margin="0,10,0,6" FontSize="11" TextWrapping="Wrap"/>

                    <StackPanel x:Name="TravelTimeLegend" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock Text="Travel time" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Rectangle Width="18" Height="12" Fill="#3C008000" Stroke="#008000" Margin="0,0,6,0"/>
                            <TextBlock Text="15 minutes"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Rectangle Width="18" Height="12" Fill="#3CFFFF00" Stroke="#FFFF00" Margin="0,0,6,0"/>
                            <TextBlock Text="30 minutes"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Rectangle Width="18" Height="12" Fill="#3CFFA500" Stroke="#FFA500" Margin="0,0,6,0"/>
                            <TextBlock Text="45 minutes"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Rectangle Width="18" Height="12" Fill="#3CFF0000" Stroke="#FF0000" Margin="0,0,6,0"/>
                            <TextBlock Text="60 minutes"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="LsbRouteSegments" SelectionChanged="LsbRouteSegments_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:CloudRoutingSegment}">
                            <StackPanel Margin="0,2,0,4">
                                <TextBlock Text="{Binding Instruction}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Distance, StringFormat=Distance: {0:0} meters}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapClick="Map_MapClick"/>
            <Image x:Name="LoadingImage" Height="64" Width="64" Visibility="Hidden" Source="..\..\Resources\loading.png"/>
        </Grid>
    </DockPanel>
</UserControl>
