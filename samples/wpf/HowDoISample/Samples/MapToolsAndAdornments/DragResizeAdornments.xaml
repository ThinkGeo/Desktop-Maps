<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.DragResizeAdornments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="Draggable" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton x:Name="RdoDragYes" GroupName="DragMode" Content="Yes" IsChecked="True" Margin="0,2" Checked="DragMode_Checked"/>
                <RadioButton x:Name="RdoDragNo" GroupName="DragMode" Content="No" Margin="0,2" Checked="DragMode_Checked"/>

                <TextBlock Text="Resizable" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <RadioButton x:Name="RdoResizeYes" GroupName="ResizeMode" Content="Yes" Margin="0,2" Checked="ResizeMode_Checked"/>
                <RadioButton x:Name="RdoResizeNo" GroupName="ResizeMode" Content="No" IsChecked="True" Margin="0,2" Checked="ResizeMode_Checked"/>

                <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="The scale line, scale bar, logo, legend and the compass that shows true north and magnetic north are all adornment layers."/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
