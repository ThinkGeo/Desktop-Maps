<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.MapToolControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Style="{DynamicResource Shell.SamplePanel}">
            <StackPanel>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Map.MapTools are WPF controls laid over the map, shown here. An AdornmentLayer is drawn by the map into one of its corners, like the scale bar, legend and north arrow in Drag/Resize Adornments. The measure overlay is interactive: it draws and labels as you drag, in Measure Distance and Area."/>

                <TextBlock Text="Map tools" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox Content="Pan zoom bar" Margin="0,2"
                          IsChecked="{Binding ElementName=Map, Path=MapTools.PanZoomBar.IsEnabled, Mode=TwoWay}"/>
                <CheckBox Content="Logo" Margin="0,2"
                          IsChecked="{Binding ElementName=Map, Path=MapTools.Logo.IsEnabled, Mode=TwoWay}"/>
                <CheckBox Content="Scale line" Margin="0,2"
                          IsChecked="{Binding ElementName=Map, Path=MapTools.ScaleLine.IsEnabled, Mode=TwoWay}"/>
                <CheckBox Content="Mouse coordinates" Margin="0,2"
                          IsChecked="{Binding ElementName=Map, Path=MapTools.MouseCoordinate.IsEnabled, Mode=TwoWay}"/>

                <TextBlock Text="Mouse coordinates as" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <RadioButton Content="Longitude, latitude" Tag="LonLat" IsChecked="True" Margin="0,2" Checked="CoordinateType_Checked"/>
                <RadioButton Content="Degrees, minutes, seconds" Tag="DMS" Margin="0,2" Checked="CoordinateType_Checked"/>
                <RadioButton Content="Map X, Y (custom format)" Tag="XY" Margin="0,2" Checked="CoordinateType_Checked"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
