<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.MeasureDistanceAndArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="340" Background="#F6F6F4" Padding="12"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Distance: press, drag and release, and the ruler labels the length and the bearing. Area: click the corners of a polygon and double-click the last one; the finished shape is labelled with its area."/>
                <TextBlock Text="Measure" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton Content="Distance" IsChecked="True" Margin="0,2" Checked="Distance_Checked"/>
                <RadioButton Content="Area" Margin="0,2" Checked="Area_Checked"/>
                <Button Content="Clear" HorizontalAlignment="Left" Padding="12,2" Margin="0,10,0,0" Click="Clear_Click"/>
            </StackPanel>
        </Border>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
