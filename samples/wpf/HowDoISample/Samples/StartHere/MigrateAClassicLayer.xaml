<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.MigrateAClassicLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Divider}" BorderThickness="0,0,1,1">
                <TextBlock Text="MapStyle.AddFeatureLayer" FontWeight="SemiBold" Margin="10,6" Foreground="{DynamicResource Shell.Text}"/>
            </Border>
            <thinkGeoUi:MapView x:Name="NewMap" Loaded="NewMap_Loaded"/>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Divider}" BorderThickness="0,0,0,1">
                <TextBlock Text="Classic LayerOverlay" FontWeight="SemiBold" Margin="10,6" Foreground="{DynamicResource Shell.Text}"/>
            </Border>
            <thinkGeoUi:MapView x:Name="ClassicMap" Background="#EAE8E2" Loaded="ClassicMap_Loaded"/>
        </DockPanel>

        <Border Grid.Column="2" Style="{DynamicResource Shell.SamplePanel}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Top" FontSize="11.5" TextWrapping="Wrap"
                           Text="Five shapefile layers styled the classic way, on their ZoomLevelSets: the left map adds them to a MapStyle with AddFeatureLayer, the right map draws them with a LayerOverlay, and the two move together. AreaStyle (hatches included), LineStyle, PointStyle, TextStyle, ValueStyle, ClassBreakStyle, RegexStyle and CompositeStyle translate; FilterStyle, ClusterPointStyle and a Style subclass of your own are named in the translation's Warnings and stay on a classic overlay."/>
                <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
