<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.NdfdWindField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>

        <Border Style="{DynamicResource Shell.MapCard}" Margin="72,12,12,12"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="Status" TextWrapping="Wrap"/>
                <ToggleButton x:Name="Mode" Content="Arrows" HorizontalAlignment="Left"
                              Margin="0,10,0,0" Padding="12,4,12,4"
                              Checked="Mode_Checked" Unchecked="Mode_Unchecked"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
