<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.NexradRadar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>

        <!-- One line of status needs no panel: it sits on the map. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,6"
                Background="#CC26282C" CornerRadius="3" IsHitTestVisible="False">
            <TextBlock x:Name="Status" Text="Loading the latest composite…" Foreground="#E7E9EC"/>
        </Border>
    </Grid>
</UserControl>
