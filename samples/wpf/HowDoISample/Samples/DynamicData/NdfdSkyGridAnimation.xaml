<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.NdfdSkyGridAnimation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <StackPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock Text="Sky cover forecast" FontWeight="SemiBold" Margin="8,8,8,2"/>
            <TextBlock x:Name="TimeText" Text="Reading the forecast…" FontSize="16" Margin="8,0,8,2" TextWrapping="Wrap"/>
            <TextBlock x:Name="HourText" Foreground="#606060" Margin="8,0,8,6"/>
            <Slider x:Name="FrameSlider" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1"
                    IsEnabled="False" Margin="8,0,8,4" ValueChanged="FrameSlider_ValueChanged"/>
            <Button x:Name="PlayButton" Content="Pause" IsEnabled="False" Margin="8,4,8,12" Click="PlayButton_Click"/>

            <TextBlock Text="Color ramp" FontWeight="SemiBold" Margin="8,0,8,4"/>
            <RadioButton Content="Weather Rainbow" GroupName="palette" IsChecked="True" Margin="8,2,8,2" Checked="Palette_Checked"/>
            <RadioButton Content="Cloud Gray" GroupName="palette" Margin="8,2,8,2" Checked="Palette_Checked"/>
            <RadioButton Content="Warm Tones" GroupName="palette" Margin="8,2,8,2" Checked="Palette_Checked"/>
            <RadioButton Content="Cool Tones" GroupName="palette" Margin="8,2,8,2" Checked="Palette_Checked"/>
            <RadioButton Content="Viridis" GroupName="palette" Margin="8,2,8,2" Checked="Palette_Checked"/>
        </StackPanel>
    </Grid>
</UserControl>
