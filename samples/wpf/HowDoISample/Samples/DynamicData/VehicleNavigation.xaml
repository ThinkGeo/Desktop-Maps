<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.VehicleNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView x:Name="Map" MapUnit="Meter" SizeChanged="Map_SizeChanged"/>

        <Image Source="/Resources/icon_north_arrow.png"
               VerticalAlignment="Top" HorizontalAlignment="Right"
               Width="40" Height="40" Margin="5"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <RotateTransform Angle="{Binding ElementName=Map, Path=RotationAngle}"/>
            </Image.RenderTransform>
        </Image>

        <Border Style="{DynamicResource Shell.MapCard}" Margin="72,12,12,12"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OverviewButton" MinWidth="110" Content="Overview Mode" Click="OverviewButton_OnClick"/>
                <Button x:Name="ThemeButton" MinWidth="110" Margin="6,0,0,0" Content="Light Theme" Click="ThemeButton_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
