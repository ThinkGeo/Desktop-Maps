<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.VehicleNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" MapUnit="Meter" SizeChanged="Map_SizeChanged"/>

        <Image Grid.Column="0" Source="/Resources/icon_north_arrow.png"
               VerticalAlignment="Top" HorizontalAlignment="Right"
               Width="40" Height="40" Margin="5"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <RotateTransform Angle="{Binding ElementName=Map, Path=RotationAngle}"/>
            </Image.RenderTransform>
        </Image>

        <Border Grid.Column="1" Background="#F6F6F4" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Padding="12">
            <Button x:Name="OverviewButton"
                    Width="100" Height="40"
                    Content="Overview Mode"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="OverviewButton_OnClick"/>
        </Border>
    </Grid>
</UserControl>
