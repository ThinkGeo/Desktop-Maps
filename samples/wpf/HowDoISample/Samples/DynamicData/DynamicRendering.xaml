<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.DynamicRendering"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "states",
      "paint": { "fill-color": "rgba(46,50,56,1)" } },

    { "type": "line",
      "source-layer": "states",
      "paint": {
          "line-color": "rgba(120,126,134,1)",
          "line-width": 1 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>

        <Border Style="{DynamicResource Shell.MapCard}" Width="340"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <DockPanel>
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Padding="12,4" Content="Play" Click="PlayButton_Click"/>
                <TextBlock x:Name="YearLabel" DockPanel.Dock="Left" Width="44" VerticalAlignment="Center" Margin="8,0,4,0" Text="1950"/>
                <Slider x:Name="YearSlider" Minimum="1950" Maximum="2020" Value="1950" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" ValueChanged="YearSlider_ValueChanged"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
