<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.LiveFlights"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged" MapMouseMove="Map_MapMouseMove"/>
            <!-- The hover card floats over the map next to the cursor. -->
            <Border x:Name="HoverCard" Background="#EBFFFFFF" BorderBrush="#B0B0B0" BorderThickness="1"
                    CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock x:Name="HoverText" Margin="8,5,8,5"/>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="#F6F6F4" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Padding="12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Top" Foreground="#606060" TextWrapping="Wrap"
                           Text="color = altitude:  amber &lt; 3 km   green 3-8 km   blue cruise"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <TextBlock x:Name="SpeedLabel" Text="time x120" Width="70"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="SpeedSlider" Minimum="1" Maximum="240" Value="120"
                            VerticalAlignment="Center"
                            ValueChanged="SpeedSlider_ValueChanged"/>
                </DockPanel>
                <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
