<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ShapeMeasurements"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- One document for both datasets: parks arrive as areas, trails as lines,
             and each rule draws whichever is there. -->
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "data",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
          "fill-color": "rgba(255,165,0,0.25)",
          "fill-outline-color": "#E0A458" }
    },

    { "type": "line",
      "source-layer": "data",
      "paint": {
          "line-color": "#E0A458",
          "line-width": 2 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Measurement" FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                    <RadioButton x:Name="MeaArea" Content="Area" IsChecked="True" Checked="Measurement_Checked"/>
                    <RadioButton x:Name="MeaLength" Content="Length" Checked="Measurement_Checked"/>
                    <RadioButton x:Name="MeaCenter" Content="Center point" Checked="Measurement_Checked"/>
                    <RadioButton x:Name="MeaShortest" Content="Shortest line to the stadium" Checked="Measurement_Checked"/>
                    <RadioButton x:Name="MeaSubLine" Content="A line along a line" Checked="Measurement_Checked"/>

                    <StackPanel x:Name="SubLinePanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="Start this far along (meters)" FontSize="11.5"/>
                        <TextBox x:Name="StartingOffset" Text="500" Height="22" TextChanged="Parameter_TextChanged"/>
                        <TextBlock Text="and run this far (meters)" FontSize="11.5" Margin="0,6,0,0"/>
                        <TextBox x:Name="RunLength" Text="1000" Height="22" TextChanged="Parameter_TextChanged"/>
                    </StackPanel>

                    <TextBlock x:Name="Result" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <TextBlock x:Name="Hint" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>

                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                               Text="Orange is the data; green is what was measured. Every measurement here is one call on the shape you clicked - the map work around it is the same either way."/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
