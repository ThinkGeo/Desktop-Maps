<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ValidateTopology"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- The shapes sit in their own small coordinate space, not on the ground, so
             there is no basemap under them - just a plain background. -->
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#f5f5f5" } }
  ]
}</sys:String>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,1,0,1"/>
        </Style>
        <Style x:Key="GroupHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2A4A7A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" Loaded="Map_Loaded"/>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock DockPanel.Dock="Top" Text="Rule" FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <ScrollViewer DockPanel.Dock="Top" Height="220" VerticalScrollBarVisibility="Auto" Margin="8,0,8,4">
                <StackPanel>
                    <TextBlock Text="Points" Style="{StaticResource GroupHeading}" Margin="0,0,0,4"/>
                    <RadioButton x:Name="RulePointsTouchLines" Content="Must touch lines" IsChecked="True" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePointsTouchLineEndpoints" Content="Must touch line endpoints" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePointsTouchPolygonBoundaries" Content="Must touch polygon boundaries" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePointsWithinPolygons" Content="Must be within polygons" Checked="Rule_Checked"/>

                    <TextBlock Text="Lines" Style="{StaticResource GroupHeading}"/>
                    <RadioButton x:Name="RuleLineEndpointsTouchPoints" Content="Endpoints must touch points" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesOverlapPolygonBoundaries" Content="Must overlap polygon boundaries" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesCoveredByLines" Content="Must be covered by other lines" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesSinglePart" Content="Must be a single part" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesFormClosedPolygon" Content="Must form a closed polygon" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesNoPseudonodes" Content="Must not have pseudonodes" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesNoIntersect" Content="Must not intersect" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesNoSelfIntersectOrTouch" Content="Must not self-intersect or touch" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesNoOverlap" Content="Must not overlap" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesNoOverlapLines" Content="Must not overlap other lines" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesNoSelfIntersect" Content="Must not self-intersect" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RuleLinesNoSelfOverlap" Content="Must not self-overlap" Checked="Rule_Checked"/>

                    <TextBlock Text="Polygons" Style="{StaticResource GroupHeading}"/>
                    <RadioButton x:Name="RulePolygonBoundariesOverlapBoundaries" Content="Boundaries must overlap boundaries" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePolygonBoundariesOverlapLines" Content="Boundaries must overlap lines" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePolygonsOverlapPolygons" Content="Must overlap other polygons" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePolygonsWithinPolygons" Content="Must be within other polygons" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePolygonsContainPoints" Content="Must contain points" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePolygonsOverlapEachOther" Content="Must overlap each other" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePolygonsNoGaps" Content="Must not leave gaps" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePolygonsNoOverlap" Content="Must not overlap" Checked="Rule_Checked"/>
                    <RadioButton x:Name="RulePolygonsNoOverlapPolygons" Content="Must not overlap other polygons" Checked="Rule_Checked"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                <TextBlock x:Name="Result" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Foreground="#444A52" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                           Text="Blue is what the rule is checked against. Green is what is being checked. Red is what the validator handed back as breaking the rule - sometimes a whole feature, sometimes only the part of it that is wrong."/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="style.json - edit it; the map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>

            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     Text="{StaticResource StyleJson}"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
