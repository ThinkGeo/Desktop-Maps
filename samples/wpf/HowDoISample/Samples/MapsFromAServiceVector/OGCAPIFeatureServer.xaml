<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.OGCAPIFeatureServer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:wpf="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "circle",
      "source-layer": "places",
      "paint": {
          "circle-radius": 5,
          "circle-color": "rgba(139,0,0,1)" }
    },

    { "type": "symbol",
      "source-layer": "places",
      "layout": {
          "text-field": ["get", "etiqueta"],
          "text-font": ["Segoe UI Bold"],
          "text-size": 13,
          "text-offset": [0, -0.9],
          "text-anchor": "bottom" },
      "paint": {
          "text-color": "rgba(139,0,0,1)",
          "text-halo-color": "rgba(245,245,245,1)",
          "text-halo-width": 2 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <wpf:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
</UserControl>
