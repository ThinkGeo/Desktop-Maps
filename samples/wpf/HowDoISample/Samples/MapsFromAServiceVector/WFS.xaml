<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.WFS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:wpf="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "parcels",
      "paint": { "fill-color": "rgba(255,140,0,0.18)" } },

    { "type": "line",
      "source-layer": "parcels",
      "paint": {
          "line-color": "rgba(255,69,0,1)",
          "line-width": 2 }
    },

    { "type": "symbol",
      "source-layer": "parcels",
      "layout": {
          "text-field": ["get", "perceelnummer"],
          "text-font": ["Segoe UI Bold"],
          "text-size": 11 },
      "paint": {
          "text-color": "rgba(150,40,0,1)",
          "text-halo-color": "rgba(255,255,255,1)",
          "text-halo-width": 1.5 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <wpf:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
</UserControl>
