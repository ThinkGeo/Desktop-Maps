<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.NOAAWeatherWarnings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "warnings",
      "paint": {
          "fill-color": ["match", ["get", "SEVERITY"],
              "Extreme", "rgba(215,25,28,0.40)",
              "Severe", "rgba(244,109,67,0.40)",
              "Moderate", "rgba(253,174,97,0.35)",
              "Minor", "rgba(171,217,233,0.35)",
              "rgba(150,150,150,0.30)"] }
    },

    { "type": "line",
      "source-layer": "warnings",
      "paint": {
          "line-color": ["match", ["get", "SEVERITY"],
              "Extreme", "rgba(215,25,28,1)",
              "Severe", "rgba(244,109,67,1)",
              "Moderate", "rgba(253,174,97,1)",
              "Minor", "rgba(171,217,233,1)",
              "rgba(150,150,150,1)"],
          "line-width": 1.5 }
    },

    { "type": "symbol",
      "source-layer": "warnings",
      "layout": {
          "text-field": ["get", "EVENT"],
          "text-font": ["Segoe UI Bold"],
          "text-size": 11,
          "text-max-width": 16 },
      "paint": {
          "text-color": "rgba(60,60,60,1)",
          "text-halo-color": "rgba(255,255,255,1)",
          "text-halo-width": 1.5 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock DockPanel.Dock="Top" Text="style.json - edit it; the map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     Text="{StaticResource StyleJson}"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>