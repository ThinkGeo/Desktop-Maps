<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.RasterFileFormats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <StackPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock Text="File" FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <StackPanel Margin="8,0,8,4">
                <RadioButton x:Name="FmtGeoTiff" Content="GeoTIFF - NAIP aerial" IsChecked="True" Checked="Format_Checked"/>
                <RadioButton x:Name="FmtJpeg2000" Content="JPEG 2000 - the same aerial" Checked="Format_Checked"/>
                <RadioButton x:Name="FmtJpeg" Content="Plain JPEG + world file" Checked="Format_Checked"/>
                <RadioButton x:Name="FmtMrSid" Content="MrSID - world imagery" Checked="Format_Checked"/>
                <RadioButton x:Name="FmtEcw" Content="ECW - world imagery" Checked="Format_Checked"/>
                <RadioButton x:Name="FmtAsciiGrid" Content="ESRI ASCII grid - plain GdalRasterSource" Checked="Format_Checked"/>
            </StackPanel>

            <TextBlock x:Name="Status" FontFamily="Consolas" FontSize="11" Margin="8,10,8,0" TextWrapping="Wrap"/>

            <TextBlock Foreground="#444A52" TextWrapping="Wrap" FontSize="11" Margin="8,10,8,6"
                       Text="Every format goes through the same one-line registration - a tile source for the file, handed to AddRaster. The class named after the format is a GdalRasterSource underneath; it exists so the one you want is the one you find. A format with no class of its own, such as an ESRI ASCII grid, opens with GdalRasterSource itself."/>
        </StackPanel>
    </Grid>
</UserControl>
