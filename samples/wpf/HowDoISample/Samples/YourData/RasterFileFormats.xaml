<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.RasterFileFormats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel}">
            <StackPanel>
                <TextBlock Text="File" FontWeight="SemiBold" FontSize="11.5" Margin="0,6,0,4"/>
                <StackPanel Margin="0,0,0,4">
                    <RadioButton x:Name="FmtGeoTiff" Content="GeoTIFF - NAIP aerial" IsChecked="True" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtJpeg2000" Content="JPEG 2000 - the same aerial" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtJpeg" Content="Plain JPEG + world file" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtMrSid" Content="MrSID - world imagery" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtEcw" Content="ECW - world imagery" Checked="Format_Checked"/>
                </StackPanel>

                <TextBlock x:Name="Status" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,10,0,6"
                           Text="Every format goes through the same one-line registration - a tile source for the file, handed to AddRaster. The class named after the format is a GdalRasterSource underneath; it exists so the one you want is the one you find. A format with no class of its own, such as a plain JPEG with its world file, opens with GdalRasterSource itself."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
