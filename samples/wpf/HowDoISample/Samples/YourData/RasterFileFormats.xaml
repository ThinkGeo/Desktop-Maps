<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.RasterFileFormats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" Loaded="Map_Loaded"/>

        <StackPanel Grid.Column="1" Background="DimGray" Margin="10">
            <TextBlock Text="File" FontSize="16" FontWeight="Bold" Foreground="WhiteSmoke" Margin="0,0,0,6"/>

            <RadioButton x:Name="FmtGeoTiff" Content="GeoTIFF - NAIP aerial" IsChecked="True" Checked="Format_Checked"/>
            <RadioButton x:Name="FmtJpeg2000" Content="JPEG 2000 - the same aerial" Checked="Format_Checked"/>
            <RadioButton x:Name="FmtJpeg" Content="Plain JPEG + world file" Checked="Format_Checked"/>
            <RadioButton x:Name="FmtMrSid" Content="MrSID - world imagery" Checked="Format_Checked"/>
            <RadioButton x:Name="FmtEcw" Content="ECW - world imagery" Checked="Format_Checked"/>
            <RadioButton x:Name="FmtOther" Content="Anything else GDAL reads" Checked="Format_Checked"/>

            <TextBlock x:Name="Status" Foreground="#DDDDDD" FontFamily="Consolas" FontSize="11"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>

            <TextBlock Foreground="#DDDDDD" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"
                       Text="Every format goes through the same one-line registration - a tile source for the file, handed to AddRaster. The class named after the format is a GdalRasterTileSource underneath; it exists so the one you want is the one you find."/>
        </StackPanel>
    </Grid>
</UserControl>
