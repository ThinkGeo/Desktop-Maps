<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.OfflineTiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel}">
            <StackPanel>
                <TextBlock Text="Archive" FontWeight="SemiBold" FontSize="11.5" Margin="0,6,0,4"/>
                <StackPanel Margin="0,0,0,4">
                    <RadioButton x:Name="SrcVectorMbTiles" Content="Vector MBTiles + style.json" IsChecked="True" Checked="Archive_Checked"/>
                    <RadioButton x:Name="SrcVectorPmTiles" Content="Vector PMTiles + style.json" Checked="Archive_Checked"/>
                    <RadioButton x:Name="SrcRasterMbTiles" Content="Raster MBTiles" Checked="Archive_Checked"/>
                    <RadioButton x:Name="SrcRasterPmTiles" Content="Raster PMTiles" Checked="Archive_Checked"/>
                    <RadioButton x:Name="SrcFolder" Content="A folder of z/x/y tiles from QGIS" Checked="Archive_Checked"/>
                </StackPanel>

                <CheckBox x:Name="ApplyStyle" Content="Draw with its style.json" IsChecked="True" Margin="0,6,0,0"
                          Checked="Archive_Checked" Unchecked="Archive_Checked"/>

                <TextBlock x:Name="Status" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,10,0,6"
                           Text="Vector tiles carry geometry, so a style document says how to draw them; raster tiles are pictures, so what is in the archive is what you see. Either way the archive is one tile source handed to the style, and nothing is fetched from a network."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
