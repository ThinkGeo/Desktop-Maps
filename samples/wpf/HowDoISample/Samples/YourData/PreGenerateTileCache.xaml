<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.PreGenerateTileCache"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="CacheStyle" xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#F2EFE9" } },

    { "type": "fill",
      "source-layer": "FriscoCityLimits",
      "paint": { "fill-color": "#FFFFFF" } },

    { "type": "fill",
      "source-layer": "Parks",
      "paint": { "fill-color": "#B7DDA0" } },

    { "type": "line",
      "source-layer": "Streets",
      "paint": {
          "line-color": "#9A9A9A",
          "line-width": 1 } },

    { "type": "line",
      "source-layer": "FriscoCityLimits",
      "paint": {
          "line-color": "#5A6B8A",
          "line-width": 2 } }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <StackPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock Text="Tile cache" FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <TextBlock Foreground="#444A52" TextWrapping="Wrap" FontSize="11" Margin="8,0,8,4"
                       Text="Frisco's city limits, parks and streets, drawn from shapefiles by a style document and written as PNG tiles, zoom 10 to 14, into this folder:"/>
            <TextBlock x:Name="Folder" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="8,0,8,6"/>

            <StackPanel Orientation="Horizontal" Margin="8,4,8,0">
                <Button x:Name="GenerateButton" Content="Generate" Padding="12,3" Click="GenerateButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Padding="12,3" Margin="6,0,0,0" IsEnabled="False" Click="CancelButton_Click"/>
            </StackPanel>
            <ProgressBar x:Name="GenerateProgress" Height="8" Margin="8,8,8,0"/>

            <TextBlock x:Name="Status" FontFamily="Consolas" FontSize="11" Margin="8,10,8,0" TextWrapping="Wrap"/>

            <TextBlock Foreground="#444A52" TextWrapping="Wrap" FontSize="11" Margin="8,10,8,6"
                       Text="The map reads the folder back as a raster tile source, the way Offline Tiles reads a folder of z/x/y images: nothing is drawn while you browse it, and nothing is fetched from a network."/>
        </StackPanel>
    </Grid>
</UserControl>
