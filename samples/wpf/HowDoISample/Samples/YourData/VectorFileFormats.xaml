<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.VectorFileFormats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- One document draws them all: every format arrives under the same
             source-layer name, so the rules never mention which file it came from. -->
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "data",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
          "fill-color": "rgba(90,140,200,0.35)",
          "fill-outline-color": "#8AB4F0" }
    },

    { "type": "line",
      "source-layer": "data",
      "paint": {
          "line-color": "#8AB4F0",
          "line-width": 2 }
    },

    { "type": "circle",
      "source-layer": "data",
      "filter": ["==", ["geometry-type"], "Point"],
      "paint": {
          "circle-radius": 4,
          "circle-color": "#C0392B",
          "circle-stroke-color": "#FFFFFF",
          "circle-stroke-width": 1.5 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <Border Grid.Column="1" Style="{DynamicResource Shell.SamplePanel}">
            <StackPanel>
                <TextBlock Text="File" FontWeight="SemiBold" FontSize="11.5" Margin="0,6,0,4"/>
                <StackPanel Margin="0,0,0,4">
                    <RadioButton x:Name="FmtShapefile" Content="Shapefile" IsChecked="True" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtGeoJson" Content="GeoJSON" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtKml" Content="KML" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtGpx" Content="GPX" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtTab" Content="MapInfo TAB" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtTinyGeo" Content="TinyGeo" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtCad" Content="CAD (DWG)" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtGeoPdf" Content="GeoPDF" Checked="Format_Checked"/>
                    <RadioButton x:Name="FmtInMemory" Content="In memory (built in code)" Checked="Format_Checked"/>
                </StackPanel>

                <TextBlock x:Name="Status" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,10,0,6"
                           Text="A FeatureSource reads the file, a FeatureSourceVectorTileSource cuts it into tiles, and the style draws them. Only the first line differs between these - swap the source and nothing else changes."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
