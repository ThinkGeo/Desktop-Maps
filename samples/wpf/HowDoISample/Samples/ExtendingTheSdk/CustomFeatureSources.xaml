<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.CustomFeatureSources"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "circle",
      "source-layer": "vehicle-route",
      "paint": {
          "circle-radius": 5,
          "circle-color": "#0000FF",
          "circle-stroke-color": "#FFFFFF",
          "circle-stroke-width": 2 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
</UserControl>
