<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.HandleTileFailures"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Style="{DynamicResource Shell.SamplePanel}">
            <StackPanel>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="An aerial layer over the basemap is authorized by a key that is wrong on purpose, so the service answers 401 for every one of its tiles. Each failure raises TileLoadFailed with the exception; the handler decides what to draw in the tile's place and whether the tile keeps being asked for. Changing a choice refreshes the layer, so its tiles fail again under the new one."/>
                <TextBlock Text="Where the tile would be" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RadioButton x:Name="DrawDefault" Content="Draw the default failure tile" IsChecked="True" Margin="0,2"
                             Checked="Choice_Changed"/>
                <RadioButton x:Name="DrawCustom" Content="Draw my own image" Margin="0,2" Checked="Choice_Changed"/>
                <RadioButton x:Name="DrawNothing" Content="Leave it blank" Margin="0,2" Checked="Choice_Changed"/>
                <CheckBox x:Name="AskAgain" Content="Ask for the tile again on the next pan or zoom" IsChecked="True" Margin="0,12,0,0"
                          Checked="Choice_Changed" Unchecked="Choice_Changed"/>
                <TextBlock x:Name="Count" Margin="0,14,0,4" FontSize="11"
                           Text="No tile has failed yet."/>
                <TextBox x:Name="Failure" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" FontSize="11"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
