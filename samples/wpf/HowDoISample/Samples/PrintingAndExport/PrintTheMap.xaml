<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.PrintTheMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "Parks",
      "paint": {
          "fill-color": "#D3D3D3" }
    },

    { "type": "line",
      "source-layer": "Streets",
      "filter": ["&lt;=", ["to-number", ["get", "SUBTYPE"]], 6],
      "paint": {
          "line-color": "#A9A9A9",
          "line-width": 1 }
    },

    { "type": "line",
      "source-layer": "FriscoCityLimits",
      "paint": {
          "line-color": "#000000",
          "line-width": 2 }
    },

    { "type": "circle",
      "source-layer": "Frisco_Mosquitos",
      "filter": ["==", ["to-string", ["get", "DateCollec"]], "20200505"],
      "paint": {
          "circle-radius": 5,
          "circle-color": "#000000",
          "circle-stroke-color": "#FFFFFF",
          "circle-stroke-width": 2 }
    },

    { "type": "symbol",
      "source-layer": "Frisco_Mosquitos",
      "filter": ["==", ["to-string", ["get", "DateCollec"]], "20200505"],
      "layout": {
          "text-field": ["get", "TrapSite"],
          "text-size": 11,
          "text-offset": [0, 1.2] },
      "paint": {
          "text-color": "#000000",
          "text-halo-color": "#FFFFFF",
          "text-halo-width": 2 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Style="{DynamicResource Shell.SamplePanel}">
            <StackPanel>
                <TextBlock Text="Draw the map on the page with" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <RadioButton Content="Feature layers styled in code" Tag="layers" GroupName="MapContent" IsChecked="True" Margin="0,2"
                             Checked="MapContent_Checked"/>
                <RadioButton Content="A style document (style.json)" Tag="style" GroupName="MapContent" Margin="0,2"
                             Checked="MapContent_Checked"/>

                <TextBlock Text="Output" FontWeight="SemiBold" Margin="0,14,0,4"/>
                <Button Content="Print..." Click="PrintMap_Click" Margin="0,2" Padding="0,3"/>
                <Button Content="Export this page as a PDF..." Click="ExportPdf_Click" Margin="0,2" Padding="0,3"/>
                <Button Content="Export a map book as a PDF..." Click="ExportMapBook_Click" Margin="0,2" Padding="0,3"/>
                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Text="The map book is one PDF of five pages: the whole city, then each quarter of it on a page of its own."/>
                <TextBlock x:Name="Status" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
