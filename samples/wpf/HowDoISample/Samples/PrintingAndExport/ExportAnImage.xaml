<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ExportAnImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="290" Background="#F6F6F4" Padding="12,10"
                BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <StackPanel>
                <RadioButton Content="The map as it is on screen" Tag="snapshot" GroupName="Mode" IsChecked="True" Margin="0,2"
                             Checked="Mode_Checked"/>
                <RadioButton Content="Layers drawn off screen" Tag="offscreen" GroupName="Mode" Margin="0,2"
                             Checked="Mode_Checked"/>
                <TextBlock x:Name="ModeHint" Margin="0,4,0,8" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="Everything on the map, the marker included, copied into an image the size of the map."/>
                <CheckBox x:Name="WriteWorldFile" Content="Write a world file and a .prj beside it, so the image opens in place in a GIS" Margin="0,2">
                    <CheckBox.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </CheckBox.ContentTemplate>
                </CheckBox>
                <Button Content="Export..." Click="Export_Click" Margin="0,10,0,0" Padding="0,3"/>
                <TextBlock x:Name="Status" Margin="0,8,0,8" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
                <Image x:Name="Preview" Stretch="Uniform" MaxHeight="300"/>
            </StackPanel>
        </Border>

        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
