<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.RendererGuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,4"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#3C4043"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="8,5"/>
        </Style>
        <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E3E5E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,14,24,20" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="GPU or Classic?"/>
            <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                       Text="Draw the map with a style document: a GpuBasemap holding a MapStyle, with your own data added to the style as sources. Reach for the classic overlays only for the jobs listed under &#x201C;Where the classic overlays still belong&#x201D; below. An application that already has classic FeatureLayers can bring them across: FeatureLayerTranslator.Translate turns a layer and its ZoomLevelSet styles into style layers, MapStyle.AddFeatureLayer adds them, and whatever could not be translated is listed in the translation's Warnings. See Migrate a Classic Layer."/>

            <TextBlock Style="{StaticResource H2}" Text="What the user sees"/>
            <Border BorderBrush="#E3E5E8" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource RowBorder}" Grid.Row="0" Grid.ColumnSpan="3" Background="#F6F7F8"/>
                    <TextBlock Style="{StaticResource HeadCell}" Grid.Row="0" Grid.Column="1" Text="Classic overlays"/>
                    <TextBlock Style="{StaticResource HeadCell}" Grid.Row="0" Grid.Column="2" Text="Style document"/>

                    <Border Style="{StaticResource RowBorder}" Grid.Row="1" Grid.ColumnSpan="3"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="1" Grid.Column="0" Text="Zooming"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="1" Grid.Column="1" Text="Tiles stretch and blur, then turn sharp when the new tiles arrive"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="1" Grid.Column="2" Text="Sharp at every zoom in between"/>

                    <Border Style="{StaticResource RowBorder}" Grid.Row="2" Grid.ColumnSpan="3"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="2" Grid.Column="0" Text="Rotating"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="2" Grid.Column="1" Text="The picture turns, labels and all"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="2" Grid.Column="2" Text="The map turns, labels stay upright"/>

                    <Border Style="{StaticResource RowBorder}" Grid.Row="3" Grid.ColumnSpan="3"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="3" Grid.Column="0" Text="Tilt, terrain, globe"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="3" Grid.Column="1" Text="No"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="3" Grid.Column="2" Text="Yes"/>

                    <TextBlock Style="{StaticResource Cell}" Grid.Row="4" Grid.Column="0" Text="Changing the style"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="4" Grid.Column="1" Text="Every affected tile is drawn again"/>
                    <TextBlock Style="{StaticResource Cell}" Grid.Row="4" Grid.Column="2" xml:space="preserve"><Run FontWeight="SemiBold">SetLayerVisibility</Run>, <Run FontWeight="SemiBold">SetHeatmapPaint</Run>: the next frame, nothing rebuilt.
<Run FontWeight="SemiBold">SetStyleAsync</Run>: the new style is compiled and the map is rebuilt from the tiles it already holds; nothing is downloaded again.</TextBlock>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource H2}" Text="Which way for which data"/>
            <TextBlock Style="{StaticResource Body}" xml:space="preserve"><Run FontWeight="SemiBold">Basemaps, your files and databases, tile archives, map services</Run> - a source in the style document. (Your Data, Maps from a Service.)
<Run FontWeight="SemiBold">Things that move every frame</Run> - vehicles, aircraft, animated circles, a growing track: a DynamicSource in the style, updated one feature at a time. (Dynamic Rendering, Live Flights, Vehicle Navigation.)
<Run FontWeight="SemiBold">Feature state that changes over time</Run> - not a paint delegate that reads the clock: what a delegate returns for a feature is baked into the tile when the tile is built, and does not change after that. Use a DynamicSource, or build the variants as layers and switch their visibility. (Render Based on Code.)
<Run FontWeight="SemiBold">Fields</Run> - a grid of values, wind, readings at points: GridSource, VectorFieldSource, PointValueSource. (Animate a Weather Grid, Wind as a Vector Field, Isolines.)</TextBlock>

            <TextBlock Style="{StaticResource H2}" Text="Where the classic overlays still belong"/>
            <TextBlock Style="{StaticResource Body}" xml:space="preserve"><Run FontWeight="SemiBold">Content made from the whole view</Run> - graticule lines, whose spacing and edge labels follow the viewport. (Display Graticule Lines.)
<Run FontWeight="SemiBold">WPF elements and interaction</Run> - markers (any WPF content; tens of them, not thousands), popups, drawing and editing shapes, measuring, scale bars, legends and north arrows. (Markers &amp; Popups, Draw &amp; Edit, Map Tools &amp; Adornments.)
<Run FontWeight="SemiBold">Drawing only the classic layers do</Run> - S-52 nautical charts, raster tiles reprojected as they are read, and the keyed commercial raster providers. (Nautical Charts, Reproject a Raster.)
Printing is not on this list: MapStyleAsyncLayer draws a style document wherever a classic layer can be drawn, a printed page included. (Print the Map.)</TextBlock>

            <TextBlock Style="{StaticResource H2}" Text="When the map tilts"/>
            <TextBlock Style="{StaticResource Body}" xml:space="preserve"><Run FontWeight="SemiBold">Markers and popups</Run> move with the ground and stay where they belong. (Markers.)
<Run FontWeight="SemiBold">Tile and layer overlays</Run> are laid onto the ground as a picture, above all of the style's layers, labels included.
<Run FontWeight="SemiBold">FeatureLayerWpfDrawingOverlay</Run> is hidden.
<Run FontWeight="SemiBold">Drawing, editing and measuring</Run> overlays are neither hidden nor tilted: use them on the flat map.
<Run FontWeight="SemiBold">ExtentOverlay.PanMode</Run> is set to Disabled while the map is tilted - the camera pans instead - and given back when it is flat again.</TextBlock>

            <TextBlock Style="{StaticResource H2}" Text="See it side by side"/>
            <TextBlock Style="{StaticResource Body}"
                       Text="Migrate a Classic Layer draws the same layers both ways, the two maps moving together. CPU vs GPU Projection does the same for projecting data: on the left the data is projected as it is read, on the right as it is drawn."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
