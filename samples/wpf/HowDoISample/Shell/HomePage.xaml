<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Shell.Page}" Foreground="{StaticResource Shell.Text}">
    <UserControl.Resources>
        <!-- The featured buttons are made in code; an implicit style dresses them. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Shell.Text}" />
            <Setter Property="Background" Value="{StaticResource Shell.Hover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Shell.Divider}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Shell.Selected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Shell.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource Shell.TextDim}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{StaticResource Shell.Header}" BorderBrush="{StaticResource Shell.Divider}"
                                    BorderThickness="0,0,1,1" Padding="6,5">
                                <ContentPresenter />
                            </Border>
                            <!-- The grip a column is dragged wider or narrower by; GridView looks for it by name. -->
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0"
                                   Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Shell.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Shell.Divider}"
                                BorderThickness="0,0,0,1" Padding="0,3">
                            <GridViewRowPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Shell.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Shell.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16,14,16,10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="ThinkGeo Desktop Maps for WPF - How Do I" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="Subtitle" Foreground="{StaticResource Shell.TextDim}" FontSize="12" Margin="0,3,0,0"/>

            <!-- New in 15: one sample each, built from SampleCatalog.Featured. -->
            <TextBlock Text="NEW IN THINKGEO 15" Foreground="{StaticResource Shell.Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <WrapPanel x:Name="Featured"/>

            <!-- The table is generated from the same catalog the menu is, so it
                 cannot fall behind it. The document it replaced was generated on the
                 classic side and was missing 23 of this app's samples, every
                 GPU-only one among them. -->
            <Grid Margin="0,12,0,6">
                <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" FontSize="13" Padding="4,3"
                         Background="{StaticResource Shell.Sidebar.Input}" Foreground="{StaticResource Shell.Text}"
                         BorderBrush="{StaticResource Shell.Divider}" CaretBrush="{StaticResource Shell.Text}"/>
                <TextBlock x:Name="FilterHint" Text="Filter by name, focus or API"
                           Foreground="{StaticResource Shell.TextDim}" FontSize="13" Margin="7,4,0,0" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="FilterStatus" Foreground="{StaticResource Shell.TextDim}" FontSize="11" Margin="1,0,0,6"/>
        </StackPanel>

        <ListView x:Name="Rows" MouseDoubleClick="Rows_MouseDoubleClick" SelectionChanged="Rows_SelectionChanged"
                  FontSize="12" BorderThickness="1" BorderBrush="{StaticResource Shell.Divider}"
                  Background="{StaticResource Shell.Page}" Foreground="{StaticResource Shell.Text}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Group" Width="170" DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="Sample" Width="220" DisplayMemberBinding="{Binding Title}"/>
                    <!-- Hover a row for the whole sentence; drag a header's edge to widen the column. -->
                    <GridViewColumn Header="Does what" Width="560">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Focus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Focus}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Key API" Width="220" DisplayMemberBinding="{Binding KeyApi}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
