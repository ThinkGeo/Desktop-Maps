<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.MigrateAClassicLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="12,8"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <TextBlock FontSize="11.5" Foreground="#555B62" TextWrapping="Wrap"
                       Text="Five shapefile layers styled the classic way - AreaStyle, LineStyle, PointStyle, TextStyle and a ValueStyle on their ZoomLevelSets. The left map adds them to a MapStyle with AddFeatureLayer; the right map draws them with a LayerOverlay. Pan or zoom either map; the school names and the street names arrive one zoom level apart on both."/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F6F6F4" Padding="12,6"
                BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <TextBlock x:Name="Status" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                    <TextBlock Text="MapStyle.AddFeatureLayer" FontWeight="SemiBold" Margin="10,6"/>
                </Border>
                <thinkGeoUi:MapView x:Name="NewMap" Loaded="NewMap_Loaded"/>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                    <TextBlock Text="Classic LayerOverlay" FontWeight="SemiBold" Margin="10,6"/>
                </Border>
                <thinkGeoUi:MapView x:Name="ClassicMap" Background="#EAE8E2" Loaded="ClassicMap_Loaded"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
