<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.EditWithConstraints"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView Grid.Column="0" Grid.Row="0" x:Name="Map" SizeChanged="Map_SizeChanged"/>
        <Grid Grid.Column="1" Grid.Row="0">
            <Label Grid.Row="0" Content="Interactive Controls:" FontWeight="Bold" FontSize="16"/>

            <RadioButton Grid.Row="1" Content="Edit Shapes" IsChecked="True" Checked="EditShapes_Checked"/>
            <RadioButton Grid.Row="2" Content="Draw Polygon" Click="DrawPolygon_Click"/>

            <Label Grid.Row="3" Content="Moved Vertex:" FontWeight="Bold" FontSize="16"/>
            <Grid Grid.Row="4" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="X:"/>
                <TextBox Grid.Column="1" x:Name="VertexX" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Y:"/>
                <TextBox Grid.Column="3" x:Name="VertexY" VerticalAlignment="Center"/>
            </Grid>
            <Button Grid.Row="5" Content="Apply Exact Coordinates" Margin="8,10,8,0" Click="ApplyCoordinates_Click"/>

            <Label Grid.Row="6" Content="Instructions:" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="Instructions" TextWrapping="Wrap" Grid.Row="7"></TextBlock>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
        </Grid>
        <!-- Grid Layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
    </Grid>

    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="WhiteSmoke"></Setter>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="DimGray"></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="20"></Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="WhiteSmoke"></Setter>
            <Setter Property="Margin" Value="4"></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="22"></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="WhiteSmoke"></Setter>
            <Setter Property="Margin" Value="8,0,0,0"></Setter>
        </Style>
    </UserControl.Resources>
</UserControl>
