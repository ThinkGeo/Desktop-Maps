<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Terrain3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- The relief shading layer, reading the DEM that SetTerrain(DemSource) declares under "terrain-dem". -->
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "hillshade",
      "source": "terrain-dem",
      "paint": { "hillshade-exaggeration": 0.4 } }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <thinkGeoUi:MapView x:Name="Map" Loaded="Map_Loaded" MapClick="Map_MapClick"/>

            <!-- The profile chart: distance along the line across, elevation up. -->
            <Border x:Name="ChartPanel" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,12" Padding="8" Background="#E6FFFFFF" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="ChartTitle" FontSize="11" Margin="0,0,0,4"/>
                    <Canvas x:Name="Chart" Width="320" Height="110" ClipToBounds="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock DockPanel.Dock="Top" Text="style.json - edit it; the map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                <CheckBox x:Name="TerrainToggle" Content="terrain" IsChecked="True"
                          Checked="TerrainToggle_Checked" Unchecked="TerrainToggle_Unchecked"/>
                <TextBlock x:Name="ProfileText" Text="click two points for an elevation profile"
                           FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     Text="{StaticResource StyleJson}"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
