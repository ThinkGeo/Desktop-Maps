<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.PerspectiveTilt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" Loaded="Map_Loaded"/>

        <StackPanel Grid.Column="1" Background="DimGray" Margin="10">
            <TextBlock Text="Basemap" FontSize="16" FontWeight="Bold" Foreground="WhiteSmoke" Margin="0,0,0,6"/>

            <RadioButton x:Name="TiltVector" Content="Vector tiles - Manhattan" IsChecked="True" Checked="Basemap_Checked"/>
            <RadioButton x:Name="TiltRaster" Content="Raster tiles - San Francisco Bay" Checked="Basemap_Checked"/>

            <TextBlock Foreground="#DDDDDD" TextWrapping="Wrap" FontSize="11" Margin="0,16,0,0"
                       Text="Right-drag tilts. Left-drag pans, and the ground you grabbed stays under the cursor. Alt and left-drag rotates; the wheel zooms. None of that is in this sample - it is what the MapView does once TiltInteractionEnabled is set."/>

            <TextBlock Foreground="#DDDDDD" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"
                       Text="Raster tiles tilt exactly as vector tiles do. What vector adds is labels that stay upright and tiles that get coarser toward the horizon."/>
        </StackPanel>
    </Grid>
</UserControl>
