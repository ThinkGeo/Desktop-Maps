<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.Databases"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- One document draws them all: every table arrives under the same
             source-layer name, so the rules never mention which database it came from. -->
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "data",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
          "fill-color": "rgba(90,140,200,0.35)",
          "fill-outline-color": "#2A4A7A" }
    },

    { "type": "line",
      "source-layer": "data",
      "paint": {
          "line-color": "#2A4A7A",
          "line-width": 2 }
    },

    { "type": "circle",
      "source-layer": "data",
      "filter": ["==", ["geometry-type"], "Point"],
      "paint": {
          "circle-radius": 4,
          "circle-color": "#C0392B",
          "circle-stroke-color": "#FFFFFF",
          "circle-stroke-width": 1.5 }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" Loaded="Map_Loaded"/>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock DockPanel.Dock="Top" Text="Database" FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                <RadioButton x:Name="DbSqlite" Content="SQLite" IsChecked="True" Checked="Database_Checked"/>
                <RadioButton x:Name="DbGeoPackage" Content="GeoPackage" Checked="Database_Checked"/>
                <RadioButton x:Name="DbFileGeoDatabase" Content="Esri File Geodatabase" Checked="Database_Checked"/>
                <RadioButton x:Name="DbPostgres" Content="PostgreSQL / PostGIS" Checked="Database_Checked"/>
                <RadioButton x:Name="DbSqlServer" Content="SQL Server" Checked="Database_Checked"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="style.json - edit it; the map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>

            <TextBlock DockPanel.Dock="Bottom" Foreground="#444A52" TextWrapping="Wrap" FontSize="11" Margin="8,0,8,6"
                       Text="A FeatureSource reads the table, a FeatureSourceVectorTileSource cuts it into tiles, and the style draws them. Only the first line differs between these - a file path for the first three, a connection string for the two servers."/>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" FontFamily="Consolas" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     Text="{StaticResource StyleJson}"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
