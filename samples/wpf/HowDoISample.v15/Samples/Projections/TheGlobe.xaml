<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.TheGlobe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <wpf:MapView x:Name="Map" Grid.Column="0" />

        <StackPanel Grid.Column="1" Width="270" Margin="8">
            <TextBlock Text="The globe" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,10"
                       Text="A ball, from the same web-mercator satellite tiles a flat map is made of. Nothing about the data changes: the sphere happens in the vertex shader and the camera, and every coordinate the API speaks is still EPSG:3857." />

            <RadioButton x:Name="RdoGlobe" Content="Globe" IsChecked="True" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoMercator" Content="Web Mercator (what it flattens into)" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoRobinson" Content="Robinson (reached through mercator)" Checked="Projection_Checked" Margin="0,3" />
            <CheckBox x:Name="ChkMorph" Content="Animate the change" IsChecked="True" Margin="0,8,0,0" />

            <Separator Margin="0,12,0,8" />
            <TextBlock Text="Zoom in and watch it let go" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="#444" FontSize="11" Margin="0,0,0,6"
                       Text="Between zoom 5 and 6 the ball eases into flat mercator and then hands over completely. A flattened globe IS web mercator - that is what the tangent plane at the center comes out as - so the handover has nothing to hide." />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnWorld" Content="world" Click="World_Click" Padding="8,3" Margin="0,0,4,0" />
                <Button x:Name="BtnBand" Content="the band" Click="Band_Click" Padding="8,3" Margin="0,0,4,0" />
                <Button x:Name="BtnStreet" Content="past it" Click="Street_Click" Padding="8,3" />
            </StackPanel>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                       Foreground="#444" Margin="0,10,0,0" Text="" />

            <Separator Margin="0,12,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="#444" FontSize="11"
                       Text="Three things worth knowing. The ball is FITTED to the map's scale: the ground under the screen center is drawn at the size a flat map would draw it, which is what makes the handover seamless. Dragging holds that size - move north and the scale changes rather than the ball, because a mercator meter is less ground the further north it is. And web mercator stops at 85 degrees, so the sphere above that has no tile: the caps are drawn from the top row of the tiles that reach the edge." />
        </StackPanel>
    </Grid>
</UserControl>
