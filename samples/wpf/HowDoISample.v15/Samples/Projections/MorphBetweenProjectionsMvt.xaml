<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.MorphBetweenProjectionsMvt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView Grid.Column="0" x:Name="Map" />

        <StackPanel Grid.Column="1" Width="250" Margin="8,8,8,8">
            <TextBlock Text="Projection" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,10"
                       Text="An ordinary map in whichever projection you pick - zoom, pan, the style as drawn - reading the same web-mercator vector tiles. Picking a projection keeps the ground you are looking at." />

            <RadioButton x:Name="RdoMercator" Content="Spherical Mercator" IsChecked="True" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoEquirectangular" Content="Equirectangular (degrees)" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoRobinson" Content="Robinson" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoMollweide" Content="Mollweide" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoEckert" Content="Equal Area - Eckert IV" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoCylindrical" Content="Equal Area - Cylindrical" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoSinusoidal" Content="Equal Area - Sinusoidal" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoBonne" Content="Equal Area - Bonne" Checked="Projection_Checked" Margin="0,3" />
            <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,2,0,0" FontSize="11"
                       Text="The last two carry no formula in the renderer - they are drawn from a grid, which is how any proj4 definition gets here." />

            <TextBlock Text="Region only" FontWeight="Bold" Margin="0,12,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,4" FontSize="11"
                       Text="Neither covers the globe - the view frames the ground the definition is for, and leaving it is warned about." />
            <RadioButton x:Name="RdoAlbers" Content="Equal Area - Albers Conic (US)" Checked="Projection_Checked" Margin="0,3" />
            <RadioButton x:Name="RdoMga55" Content="MGA Zone 55 (E Australia)" Checked="Projection_Checked" Margin="0,3" />

            <CheckBox x:Name="ChkMorph" Content="Animate the change" IsChecked="True" Margin="0,12,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,2,0,0" FontSize="11"
                       Text="The world unrolls from one canvas onto the other instead of cutting. The tiles are not refetched: only the projection the renderer draws them through moves." />

            <TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"
                       Foreground="#B04A2A" Visibility="Collapsed" />

            <Separator Margin="0,12,0,8" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="#444"
                       Text="opening the map..." />

            <TextBlock Text="Timing" FontWeight="Bold" Margin="0,10,0,0" FontSize="11" />
            <TextBox x:Name="TimingLog" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Foreground="#444"
                     Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="1" BorderBrush="#DDD" Background="#FAFAFA" TextWrapping="NoWrap" />
        </StackPanel>
    </Grid>
</UserControl>
