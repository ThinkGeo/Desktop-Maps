<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.ReprojectRasterTiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <thinkGeoUi:MapView Grid.Column="0" Grid.Row="0" x:Name="Map" SizeChanged="Map_SizeChanged"></thinkGeoUi:MapView>
        <Grid Grid.Column="1" Grid.Row="0">
            <Label Grid.Column="1" Grid.Row="0" Content="Reproject Raster Tiles:" FontWeight="Bold" FontSize="16" Margin="-8 10 0 0" />

            <Label Grid.Column="1" Grid.Row="1" Margin="0 10 0 0" Content="Server:" FontSize="14" FontWeight="Bold"></Label>
            <ComboBox Grid.Column="1" Grid.Row="2" x:Name="ServerCombo" SelectionChanged="Server_SelectionChanged">
                <ComboBoxItem IsSelected="True">ThinkGeo Cloud XYZ</ComboBoxItem>
                <ComboBoxItem>OpenStreetMap</ComboBoxItem>
            </ComboBox>

            <Label Grid.Column="1" Grid.Row="3" Margin="0 10 0 0" Content="Projection:" FontSize="14" FontWeight="Bold"></Label>
            <StackPanel Grid.Column="1" Grid.Row="4">
                <RadioButton Checked="Projection_Checked" Tag="3857" IsChecked="True">EPSG:3857 (native)</RadioButton>
                <RadioButton Checked="Projection_Checked" Tag="4326">EPSG:4326</RadioButton>
            </StackPanel>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
        </Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
    </Grid>
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="WhiteSmoke"></Setter>
            <Setter Property="FontSize" Value="14"></Setter>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="DimGray"></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="22"></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="WhiteSmoke"></Setter>
        </Style>
    </UserControl.Resources>
</UserControl>
