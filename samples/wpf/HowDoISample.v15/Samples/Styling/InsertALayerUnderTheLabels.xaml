<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.InsertALayerUnderTheLabels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="12,8"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="wash opacity:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="WashSlider" Minimum="0" Maximum="0.9" Value="0.45"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WashReadout" Width="40" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                           Text="aerial (raster) -> roads (vector) -> white wash (fill) -> labels (vector). The wash mutes the imagery and the roads while the labels stay crisp; an overlay could only ever sit above everything, labels included."/>
            </StackPanel>
        </Border>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
