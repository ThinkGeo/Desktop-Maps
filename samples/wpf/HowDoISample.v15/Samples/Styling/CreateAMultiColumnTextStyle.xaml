<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.CreateAMultiColumnTextStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" SizeChanged="Map_SizeChanged"/>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock DockPanel.Dock="Top" Text="style.json - edit it and the map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#DDE8F0" } },

    { "type": "fill",
      "source-layer": "Countries02",
      "paint": {
          "fill-color": "#E9E8D6",
          "fill-outline-color": "#B5B5A5" }
    },

    { "type": "symbol",
      "source-layer": "WorldCapitals",
      "layout": {
          "text-field": ["concat",
              ["get", "CITY_NAME"], "\n",
              "Population: ", ["get", "POPULATION"]],
          "text-font": ["Noto Sans Bold"],
          "text-size": 11 },
      "paint": { "text-color": "#1A1A1A" }
    }
  ]
}</TextBox>
        </DockPanel>
    </Grid>
</UserControl>
