<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.DisplayDotDensity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="12,8"
                    BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#1F78B4" VerticalAlignment="Center"/>
                        <TextBlock Text="Owner-occupied" FontSize="11.5" Margin="6,0,18,0" VerticalAlignment="Center"/>
                        <Ellipse Width="10" Height="10" Fill="#F07814" VerticalAlignment="Center"/>
                        <TextBlock Text="Renter-occupied" FontSize="11.5" Margin="6,0,18,0" VerticalAlignment="Center"/>
                        <TextBlock Text="1 dot = 25,000 housing units (1990 census)" FontSize="11.5"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                               Text="The dots are generated once and drawn as data - a per-tile scatter would re-arrange itself at every zoom. Where a dot sits inside its state is invented; how many there are is not."/>
                </StackPanel>
            </Border>
            <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
        </DockPanel>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock DockPanel.Dock="Top" Text="style.json - edit it and the map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     xml:space="preserve">{
  "layers": [

    { "type": "background",
      "paint": { "background-color": "#DDE8F0" } },

    { "type": "fill",
      "source-layer": "USStates_3857",
      "paint": {
          "fill-color": "#FCFCFA",
          "fill-outline-color": "#787878" }
    },

    { "type": "circle",
      "source-layer": "owner",
      "paint": {
          "circle-radius": 1.9,
          "circle-color": "#1F78B4" }
    },

    { "type": "circle",
      "source-layer": "renter",
      "paint": {
          "circle-radius": 1.9,
          "circle-color": "#F07814" }
    }
  ]
}</TextBox>
        </DockPanel>
    </Grid>
</UserControl>
