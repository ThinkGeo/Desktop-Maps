<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.DisplayClusterPoints"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F2F2F2" Padding="12,8"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <TextBlock FontSize="11" Foreground="#555B62" TextWrapping="Wrap"
                       Text="The sightings are bucketed on a screen-pixel grid for the current view, one marker per bucket. Zoom and the clusters split; click one to zoom into it."/>
        </Border>
        <thinkGeoUi:MapView x:Name="Map" SizeChanged="Map_SizeChanged"/>
    </DockPanel>
</UserControl>
