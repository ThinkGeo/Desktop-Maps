<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.MeasureDistanceAndArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <RadioButton Content="Distance" IsChecked="True" Margin="10,8,6,8" Checked="Distance_Checked"/>
            <RadioButton Content="Area" Margin="6,8,6,8" Checked="Area_Checked"/>
            <Button Content="Clear" Padding="10,2,10,2" Margin="10,6,10,6" Click="Clear_Click"/>
        </StackPanel>
        <thinkGeoUi:MapView x:Name="Map" Loaded="Map_Loaded"/>
    </DockPanel>
</UserControl>
