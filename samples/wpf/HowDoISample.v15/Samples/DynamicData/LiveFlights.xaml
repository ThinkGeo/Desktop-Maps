<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.LiveFlights"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" Background="#F2F2F2" Height="34">
            <Slider x:Name="SpeedSlider" DockPanel.Dock="Right" Minimum="1" Maximum="240" Value="120"
                    Width="160" VerticalAlignment="Center" Margin="0,0,8,0"
                    ValueChanged="SpeedSlider_ValueChanged"/>
            <TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right" Text="time x120" Width="70"
                       VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#606060" Margin="0,0,8,0"
                       Text="color = altitude:  amber &lt; 3 km   green 3-8 km   blue cruise"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,8,0"/>
        </DockPanel>

        <Grid>
            <thinkGeoUi:MapView x:Name="Map" Loaded="Map_Loaded" MapMouseMove="Map_MapMouseMove"/>
            <!-- The hover card floats over the map next to the cursor. -->
            <Border x:Name="HoverCard" Background="#EBFFFFFF" BorderBrush="#B0B0B0" BorderThickness="1"
                    CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock x:Name="HoverText" Margin="8,5,8,5"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
