<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.NdfdWindField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" Background="#F2F2F2">
            <ToggleButton x:Name="Mode" DockPanel.Dock="Right" Content="Arrows"
                          Margin="8" Padding="12,4,12,4"
                          Checked="Mode_Checked" Unchecked="Mode_Unchecked"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>
        <thinkGeoUi:MapView x:Name="Map" Loaded="Map_Loaded"/>
    </DockPanel>
</UserControl>
