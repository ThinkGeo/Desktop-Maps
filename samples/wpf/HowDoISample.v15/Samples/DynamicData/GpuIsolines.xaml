<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.GpuIsolines"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <!-- A WrapPanel, not a single row: this toolbar has outgrown one line, and a
             DockPanel silently pushes whatever does not fit past the window edge. -->
        <WrapPanel DockPanel.Dock="Bottom" Background="WhiteSmoke" Orientation="Horizontal">
            <ComboBox x:Name="PointCountCombo" Width="170" VerticalAlignment="Center" Margin="12,4,0,4"
                      SelectionChanged="PointCountCombo_SelectionChanged">
                <ComboBoxItem/>
                <ComboBoxItem Content="1,000 points (synthetic)"/>
                <ComboBoxItem Content="10,000 points (synthetic)"/>
                <ComboBoxItem Content="100,000 points (synthetic)"/>
            </ComboBox>
            <CheckBox Content="fill bands" VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="FillToggle_Changed" Unchecked="FillToggle_Changed"/>
            <CheckBox Content="labels" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="LabelToggle_Changed" Unchecked="LabelToggle_Changed"/>
            <CheckBox x:Name="PointToggle" Content="data points (&lt;= 2,000)" IsChecked="True"
                      VerticalAlignment="Center" Margin="12,4,0,4"
                      Checked="PointToggle_Changed" Unchecked="PointToggle_Changed"
                      ToolTip="The measurements the surface is interpolated FROM. Shown for up to 2,000 points - past that the markers would drown the map and the point they are making."/>
            <CheckBox Content="rebuild/frame" VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="EveryFrameToggle_Changed" Unchecked="EveryFrameToggle_Changed"
                      ToolTip="Rebuild the surface every frame instead of when it goes stale - the honest way to find out whether the intermediate grid is a concept you need. At 16 points nothing changes; at 100,000 it crawls."/>
            <Button x:Name="ExportButton" Content="export features" VerticalAlignment="Center"
                    Margin="12,0,0,0" Padding="8,2,8,2" Click="ExportButton_Click"
                    ToolTip="Read the GPU field back, run the SDK's marching squares on it (IsoLineLayer.GetIsoFeatures), and DRAW the result as classic features over the GPU contours - so the geometry can be compared with the per-pixel drawing it came from, and then queried, measured or exported like any other feature."/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,4,0,4">
                <TextBlock Text="levels" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider x:Name="LevelSlider" Minimum="2" Maximum="60" Value="25" Width="150"
                        VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="LevelSlider_ValueChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,4,0,4">
                <TextBlock Text="width" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider x:Name="WidthSlider" Minimum="1" Maximum="8" Value="3" Width="100"
                        VerticalAlignment="Center" ValueChanged="WidthSlider_ValueChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,4,0,4">
                <TextBlock Text="power" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider x:Name="PowerSlider" Minimum="1" Maximum="4" Value="2" Width="100"
                        VerticalAlignment="Center" ValueChanged="PowerSlider_ValueChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,4,0,4">
                <TextBlock Text="radius" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <!-- In multiples of the data's own width, so the slider means the same
                     thing whatever the dataset - 0 is "every point", the classic default. -->
                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="1.5" Value="0" Width="100"
                        VerticalAlignment="Center" ValueChanged="RadiusSlider_ValueChanged"/>
            </StackPanel>
        </WrapPanel>

        <!-- The status line lives ABOVE the controls, not among them: the toolbar has
             enough in it that a message docked beside the sliders is pushed off the
             edge of the window exactly when it has something to say. -->
        <StackPanel DockPanel.Dock="Bottom" Background="WhiteSmoke">
            <TextBlock x:Name="Status" Margin="12,4,12,0" TextWrapping="NoWrap"
                       Text="field + contours run on the GPU every frame; drag the sliders - updates land on the next frame"/>
            <TextBlock x:Name="Cost" Margin="12,4,12,4" FontFamily="Consolas" FontSize="11" Foreground="DimGray"/>
        </StackPanel>

        <thinkGeoUi:MapView x:Name="Map" Loaded="Map_Loaded"/>
    </DockPanel>
</UserControl>
