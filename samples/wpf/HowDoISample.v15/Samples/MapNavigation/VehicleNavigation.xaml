<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.VehicleNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <thinkGeoUi:MapView x:Name="Map" MapUnit="Meter" SizeChanged="Map_SizeChanged"/>

            <Image Source="/Resources/icon_north_arrow.png"
                   VerticalAlignment="Top" HorizontalAlignment="Right"
                   Width="40" Height="40" Margin="5"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="{Binding ElementName=Map, Path=RotationAngle}"/>
                </Image.RenderTransform>
            </Image>

            <Button x:Name="OverviewButton"
                    Margin="10"
                    Width="100" Height="40"
                    Content="Overview Mode"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Click="OverviewButton_OnClick"/>
        </Grid>

        <StackPanel Grid.Column="1" Background="DimGray" Margin="10">
            <TextBlock Text="Camera" FontSize="16" FontWeight="Bold" Foreground="WhiteSmoke" Margin="0,0,0,6"/>

            <CheckBox x:Name="BuildingCheckBox"
                      Content="3D Buildings"
                      IsChecked="True"
                      Checked="BuildingCheckBox_CheckedChanged"
                      Unchecked="BuildingCheckBox_CheckedChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Pitch" Foreground="WhiteSmoke" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="PitchSlider" Minimum="0" Maximum="80" Value="45" Width="150"
                        VerticalAlignment="Center" ValueChanged="PitchSlider_ValueChanged"/>
                <TextBlock x:Name="PitchValueText" Text="45°" Foreground="WhiteSmoke" Width="36"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <Button x:Name="DarkThemeButton" Content="Dark Theme" Height="28" Margin="0,10,0,0"
                    Click="DarkThemeButton_OnClick"/>
        </StackPanel>
    </Grid>
</UserControl>
