<UserControl x:Class="ThinkGeo.UI.Wpf.HowDoI.Samples.FindFeaturesBySpatialRelation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:thinkGeoUi="clr-namespace:ThinkGeo.UI.Wpf;assembly=ThinkGeo.UI.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="StyleJson" xml:space="preserve">{
  "layers": [

    { "type": "fill",
      "source-layer": "zoning",
      "paint": {
          "fill-color": "rgba(147,112,219,0.35)",
          "fill-outline-color": "#6A4FA3" }
    }
  ]
}</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <thinkGeoUi:MapView x:Name="Map" Grid.Column="0" Loaded="Map_Loaded"/>

        <DockPanel Grid.Column="1" Background="#F6F6F4">
            <TextBlock DockPanel.Dock="Top" Text="Relation" FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>
            <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
                <RadioButton x:Name="RelContaining" Content="Containing" IsChecked="True" Checked="Relation_Checked"/>
                <RadioButton x:Name="RelCrossing" Content="Crossing" Checked="Relation_Checked"/>
                <RadioButton x:Name="RelDisjoint" Content="Disjoint" Checked="Relation_Checked"/>
                <RadioButton x:Name="RelIntersecting" Content="Intersecting" Checked="Relation_Checked"/>
                <RadioButton x:Name="RelOverlapping" Content="Overlapping" Checked="Relation_Checked"/>
                <RadioButton x:Name="RelTouching" Content="Touching" Checked="Relation_Checked"/>
                <RadioButton x:Name="RelWithin" Content="Within the shape" Checked="Relation_Checked"/>
                <RadioButton x:Name="RelWithinDistance" Content="Within a distance" Checked="Relation_Checked"/>

                <StackPanel x:Name="RadiusPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="Distance (meters)" FontSize="11.5"/>
                    <Slider x:Name="Radius" Minimum="100" Maximum="2000" Value="500"
                            IsSnapToTickEnabled="True" TickFrequency="100"
                            ValueChanged="Radius_ValueChanged"/>
                </StackPanel>

                <TextBlock x:Name="Result" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <TextBlock x:Name="Hint" Foreground="#444A52" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>

                <TextBlock Foreground="#444A52" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                           Text="Purple is Frisco's zoning. The dashed shape is the query; blue is what the relation matched. Every relation is the same call on the same QueryTools with a different name."/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="style.json - edit it; the map follows"
                       FontWeight="SemiBold" FontSize="11.5" Margin="8,6,8,4"/>

            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,8,6"
                       TextWrapping="Wrap" Foreground="DarkGreen"/>
            <TextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                     Text="{StaticResource StyleJson}"
                     AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="11.5" Padding="6"
                     TextWrapping="NoWrap" BorderThickness="1,0,0,0" BorderBrush="#CCCCCC"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
